# Local test Caddy config.
# The docker compose image is the standard caddy:2.8.4-alpine image, so do not
# use third-party directives such as rate_limit here.

{
    auto_https off
    admin off
    servers {
        trusted_proxies static 127.0.0.1/32 172.16.0.0/12
        client_ip_headers X-Forwarded-For X-Real-IP
    }
}

:80 {
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self' http: data: blob: 'unsafe-inline'; frame-ancestors 'none'; object-src 'none'"
        -Server
        -X-Powered-By
    }

    @blocked_admin_access {
        path /admin* /_/* /api/admins/* /api/blog-admin/webauthn/*
        not path /_astro/* /pagefind/*
        not remote_ip {$ADMIN_IP}
    }
    respond @blocked_admin_access "Forbidden" 403

    @bad_paths {
        path /.env* /.git* /.svn* /wp-* /xmlrpc* /vendor* /node_modules* /.htaccess* /backup* /sql* /config* /phpmyadmin* /mysql* /shell* /cmd* /eval* /input* /index.php* /info.php*
        not path /_astro/*
    }
    handle @bad_paths {
        respond 403
    }

    @blockedNativeAuth path \
        /api/collections/users/records \
        /api/collections/users/records/ \
        /api/collections/users/request-password-reset \
        /api/collections/users/request-password-reset/ \
        /api/collections/users/request-verification \
        /api/collections/users/request-verification/ \
        /api/collections/users/request-email-change \
        /api/collections/users/request-email-change/ \
        /api/collections/users/request-otp \
        /api/collections/users/request-otp/ \
        /api/collections/users/auth-with-otp \
        /api/collections/users/auth-with-otp/ \
        /api/collections/_pb_users_auth_/request-otp \
        /api/collections/_pb_users_auth_/request-otp/ \
        /api/collections/_pb_users_auth_/auth-with-otp \
        /api/collections/_pb_users_auth_/auth-with-otp/ \
        /api/collections/_pb_users_auth_/records \
        /api/collections/_pb_users_auth_/records/ \
        /api/collections/_pb_users_auth_/request-password-reset \
        /api/collections/_pb_users_auth_/request-password-reset/ \
        /api/collections/_pb_users_auth_/request-verification \
        /api/collections/_pb_users_auth_/request-verification/ \
        /api/collections/_pb_users_auth_/request-email-change \
        /api/collections/_pb_users_auth_/request-email-change/
    respond @blockedNativeAuth "Not Found" 404

    @pb_admin {
        path /_/*
        not path /_astro/*
    }
    handle @pb_admin {
        reverse_proxy pocketbase:8090 {
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-For {client_ip}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    @static {
        path /_astro/* /pagefind/* *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.ttf *.eot
    }
    handle @static {
        header Cache-Control "public, max-age=3600"
        file_server
    }

    handle /api/* {
        reverse_proxy pocketbase:8090 {
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-For {client_ip}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle {
        try_files {path} {path}/ =404
        file_server
    }

    log {
        output stdout
        format console
    }
}
