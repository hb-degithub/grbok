# Local test Caddy config.
# The docker compose image is the standard caddy:2.8.4-alpine image, so do not
# use third-party directives such as rate_limit here.

{
    auto_https off
    admin off
    servers {
        trusted_proxies static 127.0.0.1/32 172.16.0.0/12
        client_ip_headers X-Forwarded-For X-Real-IP
    }
}

:80 {
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self' http: data: blob: 'unsafe-inline'; frame-ancestors 'none'; object-src 'none'"
        -Server
        -X-Powered-By
    }

    # 路径解码层数不一致兜底（与生产 Caddyfile 对齐，2026-10-14 渗透测试）：
    # Caddy 的 path 匹配器只看"解一层百分号编码"后的路径，PocketBase 会对路由参数
    # 再解一层——/api/collections/%2575sers/records 在 Caddy 看来不等于 users/records，
    # 于是穿过下方 @blockedNativeAuth 与 @blocked_admin_access（本地实测 200 穿透）。
    # 判据：解一层后若仍残留 %xx，一律 404；与编码层数无关。规则收窄到
    # /api/*、/_*、/admin*，普通页面路径不受影响。
    @residual_escape {
        path /api/* /_ /_/* /admin /admin/*
        path_regexp (?i)%[0-9a-f]{2}
    }
    handle @residual_escape {
        respond "Not Found" 404
    }

    # 本地 :80 只绑定 127.0.0.1（见 docker-compose.local.yml），保留 ADMIN_IP
    # 回环豁免以便开发者访问 /_/；公网监听（生产 Caddyfile）已改为无条件 404，
    # 因为 client_ip 头可伪造、remote_ip 恒为 docker 网关，唯一不可伪造判据是入口端口。
    @blocked_admin_access {
        path /admin* /_/* /api/admins/* /api/blog-admin/*
        not path /_astro/* /pagefind/*
        not client_ip {$ADMIN_IP}
    }
    # 必须用 handle 包裹：裸 respond 在 Caddy 2.8 的指令排序中位于所有 handle 之后，
    # 会被下方 handle /api/* 与 handle @pb_admin 抢先代理到 PB，拦截静默失效
    # （生产 Caddyfile:212-214 记录同一踩坑；本地 2026-10-16 实验台实测确认）。
    handle @blocked_admin_access {
        respond "Forbidden" 403
    }

    @bad_paths {
        path /.env* /.git* /.svn* /wp-* /xmlrpc* /vendor* /node_modules* /.htaccess* /backup* /sql* /config* /phpmyadmin* /mysql* /shell* /cmd* /eval* /input* /index.php* /info.php*
        not path /_astro/*
    }
    handle @bad_paths {
        respond 403
    }

    @blockedNativeAuth path \
        /api/collections/users/records \
        /api/collections/users/records/ \
        /api/collections/users/request-password-reset \
        /api/collections/users/request-password-reset/ \
        /api/collections/users/request-verification \
        /api/collections/users/request-verification/ \
        /api/collections/users/request-email-change \
        /api/collections/users/request-email-change/ \
        /api/collections/users/request-otp \
        /api/collections/users/request-otp/ \
        /api/collections/users/auth-with-otp \
        /api/collections/users/auth-with-otp/ \
        /api/collections/_pb_users_auth_/request-otp \
        /api/collections/_pb_users_auth_/request-otp/ \
        /api/collections/_pb_users_auth_/auth-with-otp \
        /api/collections/_pb_users_auth_/auth-with-otp/ \
        /api/collections/_pb_users_auth_/records \
        /api/collections/_pb_users_auth_/records/ \
        /api/collections/_pb_users_auth_/request-password-reset \
        /api/collections/_pb_users_auth_/request-password-reset/ \
        /api/collections/_pb_users_auth_/request-verification \
        /api/collections/_pb_users_auth_/request-verification/ \
        /api/collections/_pb_users_auth_/request-email-change \
        /api/collections/_pb_users_auth_/request-email-change/
    # 同上：必须 handle 包裹，否则这串精确路径拦不住 handle /api/* 的代理。
    handle @blockedNativeAuth {
        respond "Not Found" 404
    }

    @pb_admin {
        path /_/*
        not path /_astro/*
    }
    handle @pb_admin {
        reverse_proxy pocketbase:8090 {
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-For {client_ip}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    @static {
        path /_astro/* /pagefind/* *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.ttf *.eot
        # 后缀通配（*.jpg 等）会盖过 handle /api/files/* 的路径特异性，
        # 导致 PB 文件 URL（/api/files/media_assets/...）被 file_server 拦截返回 404。
        # 生产 Caddyfile:176-181 早有该排除，本地此前缺失（2026-10-16 实验台实测 404）。
        not path /api/*
    }
    handle @static {
        header Cache-Control "public, max-age=3600"
        file_server
    }

    handle /api/* {
        @preflight method OPTIONS
        handle @preflight {
            header Access-Control-Allow-Origin "http://localhost"
            header Access-Control-Allow-Methods "GET, POST, PATCH, DELETE, OPTIONS"
            header Access-Control-Allow-Headers "Content-Type, Authorization, X-Admin-Step-Up, X-Admin-Session, X-Browser-Fingerprint, X-Admin-Recovery-Code"
            header Access-Control-Max-Age "86400"
            respond "" 204
        }

        reverse_proxy pocketbase:8090 {
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-For {client_ip}
            header_up X-Forwarded-Proto {scheme}

            header_down Access-Control-Allow-Origin "http://localhost"
            header_down Access-Control-Allow-Methods "GET, POST, PATCH, DELETE, OPTIONS"
            header_down Access-Control-Allow-Headers "Content-Type, Authorization, X-Admin-Step-Up, X-Admin-Session, X-Browser-Fingerprint, X-Admin-Recovery-Code"
            header_down Access-Control-Max-Age "86400"
        }
    }

    handle {
        try_files {path} {path}/ =404
        file_server
    }

    log {
        output stdout
        format filter {
            wrap console
            fields {
                request>uri query {
                    delete token
                }
                request>headers>Authorization delete
                request>headers>X-Admin-Step-Up delete
                request>headers>X-Admin-Session delete
                request>headers>X-Browser-Fingerprint delete
                request>headers>X-Admin-Recovery-Code delete
            }
        }
    }
}
