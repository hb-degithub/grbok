{
    servers {
        trusted_proxies static {$OPENRESTY_TRUSTED_PROXY}
        client_ip_headers X-Forwarded-For X-Real-IP
    }
}
:80 {
    encode zstd gzip
    root * /srv

    # 请求体大小限制（防止大文件上传攻击）
    request_body {
        max_size 10MB
    }

    # HTTP 方法限制：静态资源/页面只需 GET，但 PocketBase REST 写操作必须放行
    # PATCH（update）/PUT（upsert）/DELETE（删除），否则管理员无法修改/删除文章。
    @disallowed_methods not method GET POST PATCH PUT DELETE OPTIONS
    handle @disallowed_methods {
        respond "Method Not Allowed" 405
    }

    # User-Agent 过滤（拦截已知恶意爬虫/扫描器）
    @bad_ua {
        header User-Agent *sqlmap* *nikto* *nmap* *masscan* *acunetix* *nessus* *openvas* *w3af* *burp* *metasploit*
    }
    handle @bad_ua {
        redir /blocked?reason=malicious-ua 302
    }

    # /admin 前端静态页面：SSG 构建期无 cookie，服务端无法做 Astro.redirect，
    # 鉴权完全交给客户端 AdminGuard（JS 水合后执行）。这意味着未认证用户可直接
    # 获取后台页面 HTML 结构（表单字段、API 端点等），构成信息泄露与攻击面扩大。
    # 修复：在 Caddy 层对 /admin 与 /admin/* 添加 IP 白名单，与 /_/* 、/api/admins/* 同级防护。
    # 注意：path matcher 中 /admin/* 不匹配裸路径 /admin，两者都需列出。
    # 仅放行：Docker 网关 10.255.2.1（SSH 隧道回环）与显式配置的 ADMIN_IP。
    # 管理员在非白名单网络访问会收到 404，须通过 SSH 隧道或固定 IP 访问。
    @blocked_admin_pages {
        path /admin /admin/*
        not client_ip 127.0.0.1 10.255.2.1 {$ADMIN_IP}
    }
    handle @blocked_admin_pages {
        header X-Robots-Tag "noindex"
        header Cache-Control "no-store"
        respond "Not Found" 404
    }

    @blocked_admin_access {
        path /_/* /api/admins/*
        not path /_astro/* /pagefind/*
        not client_ip 127.0.0.1 10.255.2.1 {$ADMIN_IP}
    }
    handle @blocked_admin_access {
        respond "Not Found" 404
    }

    # 兼容旧路径：RSS 与 sitemap 的实际地址分别是 /feed.xml 与 /sitemap-index.xml
    redir /sitemap.xml /sitemap-index.xml 301
    redir /rss.xml /feed.xml 301

    header {
        # X-Frame-Options / X-Content-Type-Options / Referrer-Policy 由 ESA 边缘层统一注入
        # （2026-08-31 起）：此前 Caddy 与 ESA 双层重复注入导致
        # "X-Frame-Options: SAMEORIGIN, DENY" 等冲突值被浏览器直接忽略。
        # 防撞脸兜底由下方 CSP 的 frame-ancestors 'none' 承担（现代浏览器均支持）。
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Resource-Policy "same-site"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        # CSP: style-src allows 'unsafe-inline' - Framer Motion drives animations via inline styles at runtime;
        # without it, all JS-set styles are blocked and islands render broken (stacked/hidden).
        # script-src retains 'unsafe-inline' - Astro islands (client:load/visible) and is:inline scripts require it;
        # removing it would break React hydration and theme/viewport init scripts.
        Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; connect-src 'self' https://hlydwz.com wss://hlydwz.com https://www.beian.gov.cn"
        -Server
        -X-Powered-By
    }

    @bad_paths {
        path /.env* /.git* /.svn* /wp-* /xmlrpc* /vendor* /composer* /node_modules* /.htaccess* /.idea* /backup* /dump* /sql* /db* /config* /phpmyadmin* /mysql* /administrator* /shell* /cmd* /eval* /input* /server-status* /index.php* /info.php*
        not path /_astro/* /api/*
    }
    handle @bad_paths {
        redir /blocked?reason=bad-path 302
    }

    # Service worker must never be cached long-term: browsers revalidate it on every
    # navigation, and a stale sw.js breaks deploys (cached old assets/HTML).
    handle /sw.js {
        header Cache-Control "no-cache, no-store, must-revalidate"
        file_server
    }

    @static {
        path /_astro/* /pagefind/* *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.webp *.avif *.woff *.woff2 *.ttf *.eot
        not path /sw.js
    }
    handle @static {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    @blockedAccountMailRequests path \
        /api/collections/users/records \
        /api/collections/users/records/ \
        /api/collections/users/request-password-reset \
        /api/collections/users/request-password-reset/ \
        /api/collections/users/request-verification \
        /api/collections/users/request-verification/ \
        /api/collections/users/request-email-change \
        /api/collections/users/request-email-change/ \
        /api/collections/users/request-otp \
        /api/collections/users/request-otp/ \
        /api/collections/users/auth-with-otp \
        /api/collections/users/auth-with-otp/ \
        /api/collections/_pb_users_auth_/request-password-reset \
        /api/collections/_pb_users_auth_/request-password-reset/ \
        /api/collections/_pb_users_auth_/request-verification \
        /api/collections/_pb_users_auth_/request-verification/ \
        /api/collections/_pb_users_auth_/request-email-change \
        /api/collections/_pb_users_auth_/request-email-change/ \
        /api/collections/_pb_users_auth_/request-otp \
        /api/collections/_pb_users_auth_/request-otp/ \
        /api/collections/_pb_users_auth_/auth-with-otp \
        /api/collections/_pb_users_auth_/auth-with-otp/ \
        /api/collections/_pb_users_auth_/records \
        /api/collections/_pb_users_auth_/records/
    # 注意：必须用 handle 包裹（参与互斥路由的特异性排序，精确路径胜过 handle /api/*）；
    # 裸 respond 指令在 Caddy 2.8 的指令排序中位于所有 handle 之后，会被 /api/* 抢先代理到
    # PB，导致本拦截静默失效（2026-08-31 实测踩坑，adapt JSON 中 respond 排在 route 17 末位）。
    handle @blockedAccountMailRequests {
        respond "Not Found" 404
    }

    handle /api/blog-internal/mail-archive/* {
        respond "Not Found" 404
    }

    handle /api/admins/* {
        header X-Robots-Tag "noindex, nofollow, noarchive"
        reverse_proxy pocketbase:8090 {
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-For {client_ip}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /api/* {
        header X-Robots-Tag "noindex, nofollow, noarchive"
        # API 响应永不缓存：CDN（ESA）曾缓存过 /api/blog-admin/* 的 403，
        # 导致后续请求命中陈旧响应、绕过源站鉴权状态。
        header Cache-Control "no-store"

        @preflight method OPTIONS
        handle @preflight {
            header Access-Control-Allow-Origin "https://hlydwz.com"
            header Access-Control-Allow-Methods "GET, POST, PATCH, DELETE, OPTIONS"
            header Access-Control-Allow-Headers "Content-Type, Authorization, X-Admin-Step-Up, X-Admin-Session, X-Browser-Fingerprint, X-Admin-Recovery-Code"
            header Access-Control-Max-Age "86400"
            respond "" 204
        }

        reverse_proxy pocketbase:8090 {
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-For {client_ip}
            header_up X-Forwarded-Proto {scheme}

            header_down Access-Control-Allow-Origin "https://hlydwz.com"
            header_down Access-Control-Allow-Methods "GET, POST, PATCH, DELETE, OPTIONS"
            header_down Access-Control-Allow-Headers "Content-Type, Authorization, X-Admin-Step-Up, X-Admin-Session, X-Browser-Fingerprint, X-Admin-Recovery-Code"
            header_down Access-Control-Max-Age "86400"
        }
    }

    @pb_admin {
        path /_/*
        not path /_astro/*
    }
    handle @pb_admin {
        header X-Robots-Tag "noindex, nofollow, noarchive"
        reverse_proxy pocketbase:8090 {
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-For {client_ip}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /admin* {
        header X-Robots-Tag "noindex, nofollow, noarchive"
        reverse_proxy 10.255.0.1:4321 {
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-For {client_ip}
            header_up Host {host}
        }
    }

    handle /login* {
        header X-Robots-Tag "noindex, nofollow, noarchive"
        reverse_proxy 10.255.0.1:4321 {
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-For {client_ip}
            header_up Host {host}
        }
    }

    # SSR 模式（2026-08-31 重构）：构建产物不再产出任何预渲染页面（dist/client 仅静态资产），
    # 所有页面一律代理到 Astro SSR（10.255.0.1:4321）。
    # 仅当 /srv 中存在对应真实文件（_astro/pagefind/图片/robots/sitemap 等资产）时才由
    # Caddy 直接提供。切勿回退到 try_files 优先于代理的旧结构——旧结构曾让 SSG 时代的
    # 过期页面副本长期遮蔽 SSR 路由（含 feed.xml localhost 泄露）。
    handle {
        @existing_file file {path} {path}/index.html
        handle @existing_file {
            header Cache-Control "public, max-age=60, s-maxage=60, must-revalidate"
            file_server
        }
        handle {
            reverse_proxy 10.255.0.1:4321 {
                header_up X-Real-IP {client_ip}
                header_up X-Forwarded-For {client_ip}
                header_up Host {host}
            }
        }
    }

    handle_errors {
        rewrite * /{http.error.status_code}.html
        file_server
    }

    log {
        output file /data/access.log {
            roll_size 50mb
            roll_keep 10
            roll_interval 24h
            roll_keep_for 168h
        }
        format filter {
            wrap json
            fields {
                request>uri query {
                    delete token
                }
                request>headers>Authorization delete
                request>headers>X-Admin-Step-Up delete
                request>headers>X-Admin-Session delete
                request>headers>X-Browser-Fingerprint delete
                request>headers>X-Admin-Recovery-Code delete
            }
        }
    }
}
