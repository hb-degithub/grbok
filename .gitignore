# ===========================
# Git 忽略规则
# ===========================

# 敏感配置（全部忽略，仅保留模板）
.env
.env.local
.env.production
.env.astro
!.env.example

# Host-only mail archive credentials and remote configuration
mail-archive.env
rclone.conf
*.agekey
age-identity*
archive-remote.conf

# Docker 数据卷（运行时生成）
pb_data/

# pb_hooks 需要提交（包含自定义 hooks 代码）

# IDE
.vscode/
.idea/
.claude/settings.local.json
.codex/
.qoder/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Node.js
node_modules/
dist/
.cache/

# 日志
*.log
logs/

# 备份文件
backups/
*.tar.gz
*.zip

# 临时文件
tmp/
temp/

# 临时调试文件 (仅根目录, 不影响 pb_hooks/*.pb.js 和 src 下的 js)
/*.js
/*.bat
# Python test artifacts
__pycache__/
*.py[cod]

/*.vbs
/*.png
/*.jpg
/*.err
/*.log
# SSH 私钥（禁止提交）
*_key
*_ed25519
*.pem
*.key
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.ppk

# 部署临时文件
deploy-*.tar.gz
deploy-*.zip

# Local PocketBase data
pb_local/

# Superpowers local config
.superpowers/
.worktrees/

# Playwright screenshots
astro/screenshot-*.png
astro/pw-screenshot.cjs

# ZCode session workspace
.zcode/

# 历史遗留临时/备份/日志文件
original-*
.add_seo.py
rewrite-dev-*.js
PHASE1_VERIFICATION.md
pb_migrations/data.db
pb_migrations/types.d.ts
pb_hooks/*.disabled
