---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <div class="flex min-h-[60vh] items-center justify-center">
    <div class="w-full max-w-md">
      <div class="rounded-[3px] border border-[var(--sf-line)] bg-[var(--sf-surface)] p-8">
        <h1 class="mb-6 text-center text-2xl font-bold text-[var(--sf-ink)]">{title}</h1>
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>
