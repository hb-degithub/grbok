---
import BaseLayout from './BaseLayout.astro';
import AuthShell from '../components/auth/AuthShell.astro';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** 页面标题上方的眉标，默认沿用认证工作台的统一标签。 */
  eyebrow?: string;
  /** 标题的 DOM id，默认为 auth-heading（登录页由 AuthPage 使用同一 id）。 */
  headingId?: string;
  /** 登录页把 h1 交给 AuthPage 岛屿渲染，避免出现两个一级标题。 */
  showHeading?: boolean;
}

const {
  title,
  description,
  noindex,
  eyebrow,
  headingId = 'auth-heading',
  showHeading = true,
} = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <AuthShell
    title={title}
    description={description}
    eyebrow={eyebrow}
    headingId={headingId}
    showHeading={showHeading}
  >
    <slot />
  </AuthShell>
</BaseLayout>
