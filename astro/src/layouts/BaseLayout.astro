---
// import { ClientRouter } from 'astro:transitions'; // 暂时禁用，修复路由混乱问题
// 变量字体：一套子集覆盖 100–900 全字重，避免同一段中文按 400/500/700 各拉一遍子集
// （实测：静态三字重时首页字体请求 30 个 / 912KB）。字体族名见 global.css 的 @theme。
import '@fontsource-variable/noto-sans-sc/index.css';
import '@fontsource-variable/geist/index.css';
import '@fontsource-variable/geist-mono/index.css';
import Header from '../components/layout/Header';
import Footer from '../components/layout/Footer.astro';
import SearchModal from '../components/search/SearchModal';
import AnnouncementBar from '../components/layout/AnnouncementBar';
import DebugProtection from '../components/effects/DebugProtection';
import SplashOverlay from '../components/effects/SplashOverlay';
import WelcomeOverlay from '../components/effects/WelcomeOverlay';
import CursorGlow from '../components/effects/CursorGlow';
import CursorAim from '../components/effects/CursorAim';
import ToastContainer from '../components/ui/Toast';
import { SITE_CONFIG } from '../config/site';
import { isShowcasePathname } from '../lib/showcase-path';
import { pbBaseUrl } from '../lib/pb-base-url';
import { cachedFetchJson } from '../lib/pb-cache';
import type { Announcement } from '../types/pocketbase';

interface Props {
  title: string;
  description?: string;
  image?: string;
  showChrome?: boolean;
  mainClass?: string;
  noindex?: boolean;
}

const {
  title,
  description = SITE_CONFIG.description,
  image,
  showChrome = true,
  mainClass = showChrome ? 'pt-4 sm:pt-20 sm:pb-8' : '',
  noindex = false,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

/**
 * 展示页场景：首页是唯一需要「轨道日志」氛围特效的页面。
 *
 * 旧实现把 SplashOverlay / WelcomeOverlay / CursorGlow / CursorAim 全站挂载，
 * 结果是任何页面都在持续跟随指针，并且启动遮罩与欢迎遮罩可能同时阻断正文。
 * 现在只在首页挂载；内页不加载这些岛的 JS，也不会出现任何遮罩。
 * `DebugProtection` 是功能开关（后台可配），不属于装饰，因此继续全站挂载。
 *
 * 首页判定与 `WelcomeOverlay` 内部守卫共用 `isShowcasePathname()`（`lib/showcase-path.ts`）：
 * 两处各写一套时，`/index/` 会出现「岛挂载了但引导永不出现」的不一致；而 `/index/`
 * 实测走 404 页，本就不该挂首页特效，所以共享判断只认规范首页 `/`。
 */
const isShowcasePage = isShowcasePathname(Astro.url.pathname);

/**
 * 服务端预取公告。
 *
 * 为什么在布局里取：公告条此前是纯客户端渲染，水合完成后才出现，
 * 容器的 `:has(.announcement-bar)` 间距随之从 0 变 80px，整页被推下去 ——
 * 这是全站 CLS（首页 0.098、/stats/ 0.39）的主要来源。
 * 预取后公告在首屏 HTML 里就存在，间距一次到位，不再发生位移。
 *
 * 取数：走与浏览器相同的公开访问规则（匿名），800ms 超时 + 30s 进程内缓存；
 * 失败就当作没有公告（与之前客户端静默失败的表现一致），不影响页面渲染。
 */
// 与 AnnouncementBar 的 props（Announcement[] | null）保持同一类型：
// PB 记录本身就带 created/updated，无需在布局层重新声明一个更窄的结构。
let announcementsSeed: Announcement[] = [];
if (showChrome) {
  try {
    const data = await cachedFetchJson<{ items?: typeof announcementsSeed }>(
      `${pbBaseUrl()}/api/collections/announcements/records?perPage=3&sort=-created`,
      { signal: AbortSignal.timeout(800) },
      30_000,
    );
    announcementsSeed = Array.isArray(data.items) ? data.items : [];
  } catch {
    announcementsSeed = [];
  }
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="generator" content={Astro.generator} />

    <title>{title} | {SITE_CONFIG.name}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow,noarchive" />}
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={new URL(image, Astro.url)} />}

    <link rel="sitemap" href="/sitemap-index.xml" />

    <script is:inline>
      (() => {
        const storageKey = 'blog-theme-mode';
        const validModes = new Set(['system', 'time', 'light', 'dark']);
        const systemQuery = window.matchMedia('(prefers-color-scheme: dark)');

        const readMode = () => {
          const saved = window.localStorage.getItem(storageKey) || 'system';
          return validModes.has(saved) ? saved : 'system';
        };

        const resolveTheme = (mode) => {
          if (mode === 'light' || mode === 'dark') return mode;
          if (mode === 'time') {
            const hour = new Date().getHours();
            return hour >= 19 || hour < 7 ? 'dark' : 'light';
          }
          return systemQuery.matches ? 'dark' : 'light';
        };

        const applyTheme = () => {
          const mode = readMode();
          const theme = resolveTheme(mode);
          const paint = () => {
            document.documentElement.classList.toggle('dark', theme === 'dark');
          };
          if (typeof document.startViewTransition === 'function') {
            try {
              const transition = document.startViewTransition(paint);
              // Chromium 在预绘制布局校验失败时会以
              // "Transition was aborted because of invalid state" reject ready/finished；
              // 主题类已在回调里切换完成，这里只需吞掉该 rejection，
              // 否则会冒泡成页面级 unhandled rejection（移动端实测可复现）。
              transition.ready?.catch(() => {});
              transition.finished?.catch(() => {});
              transition.updateCallbackDone?.catch(() => {});
            } catch {
              // 浏览器不支持或调用被拒时，直接落主题类，保证切换结果一致
              paint();
            }
          } else {
            paint();
          }
          document.documentElement.dataset.theme = theme;
          document.documentElement.dataset.themeMode = mode;
        };

        window.__blogApplyTheme = applyTheme;
        applyTheme();
        systemQuery.addEventListener?.('change', applyTheme);
        window.addEventListener('storage', (event) => {
          if (event.key === storageKey) applyTheme();
        });
        window.setInterval(() => {
          if (readMode() === 'time') applyTheme();
        }, 60000);
      })();
    </script>
    <script is:inline>
      (() => {
        const set = () => {
          const vv = window.visualViewport || { width: window.innerWidth, height: window.innerHeight, scale: 1 };
          const root = document.documentElement;
          const vvw = Math.max(320, Math.round(vv.width));
          const vvh = Math.max(1, Math.round(vv.height || window.innerHeight || 0));
          root.style.setProperty('--vvw', `${vvw}px`);
          root.style.setProperty('--vvh', `${vvh}px`);
          root.style.setProperty('--vv-scale', `${vv.scale || 1}`);

          // Keep typography stable; adapt layout through viewport variables,
          // safe-area aware spacing, and touch target sizes.
          root.style.fontSize = '';
          if (vvw < 768) {
            root.style.setProperty('--header-h', vvh < 560 ? '3.5rem' : '4rem');
            root.style.setProperty('--header-offset', vvh < 560 ? '3.5rem' : '4rem');
            root.style.setProperty('--tap', vvw < 360 ? '2.5rem' : '2.75rem');
            root.style.setProperty('--page-pad', vvw < 360 ? '0.75rem' : '1rem');
          } else {
            root.style.setProperty('--header-h', '5rem');
            root.style.setProperty('--header-offset', '5rem');
            root.style.setProperty('--tap', '2.75rem');
            root.style.setProperty('--page-pad', '1.5rem');
          }
        };
        set();
        window.visualViewport?.addEventListener('resize', set);
        window.addEventListener('resize', set);
        window.addEventListener('orientationchange', () => setTimeout(set, 50));
      })();
    </script>

    <!-- <ClientRouter /> --> <!-- 暂时禁用，修复路由混乱问题 -->
  <style is:global>
  /* Astro view transitions */
  html {
    view-transition-name: none;
  }
  ::view-transition-old(root) {
    animation: 0.25s ease-out both fade-out;
  }
  ::view-transition-new(root) {
    animation: 0.3s ease-out both fade-in;
  }
  @keyframes fade-out {
    from { opacity: 1; }
    to { opacity: 0; }
  }
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script is:inline define:vars={{ swVersion: Date.now().toString(36) }}>
  // 注册 URL 带构建版本参数：ESA 边缘会无视 no-cache 长期缓存 /sw.js，
  // 固定路径会导致旧 Service Worker 永远无法更新（已引发过生产事故）。
  // 每次构建生成新 v=，保证浏览器和 CDN 都拿到最新 SW 脚本。
  if ("serviceWorker" in navigator) {
    navigator.serviceWorker.register(`/sw.js?v=${swVersion}`).catch(() => {});
  }
</script>
</head>
  <body class="min-h-[100svh] bg-[var(--sf-canvas)] font-sans text-[var(--sf-ink)] antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[70] focus:px-4 focus:py-2 focus:bg-[var(--sf-accent)] focus:text-[var(--sf-on-accent)] focus:rounded-[2px]">跳转到主要内容</a>
    {showChrome && <Header transition:persist="header" client:load />}
    {showChrome && <SearchModal client:idle />}
    {showChrome && (
      /*
        仅当公告真实存在时才预留导航高度：桌面避开 Dock（80px），移动端避开汉堡按钮（56px）；
        AnnouncementBar 无公告时返回 null，恒定间距会让 main 多出空白；
        这里用容器 :has(.announcement-bar) 条件间距，关闭最后一个公告后自动归 0。
      */
      <div class="relative z-40 has-[.announcement-bar]:pt-14 sm:has-[.announcement-bar]:mt-20 sm:has-[.announcement-bar]:pt-0">
        <AnnouncementBar client:idle initialAnnouncements={announcementsSeed} />
      </div>
    )}

    <main id="main-content" class:list={["w-full overflow-x-clip", mainClass]}>
      <slot />
    </main>

    {showChrome && <Footer transition:persist="footer" />}
    <DebugProtection client:idle />
    {isShowcasePage && <SplashOverlay client:idle />}
    {isShowcasePage && <WelcomeOverlay client:idle />}
    {isShowcasePage && <CursorGlow client:only="react" />}
    {isShowcasePage && <CursorAim client:only="react" />}
  <ToastContainer client:idle />
    <script define:vars={{ pbBase: import.meta.env.PUBLIC_POCKETBASE_URL || '' }}>
  // 访问统计探针：页面浏览（含客户端导航）通过 sendBeacon 上报。
  // 尊重 DNT；静默失败绝不影响页面；guard 防止 ClientRouter 重复挂监听。
  (() => {
    if (!pbBase) return;
    const send = () => {
      try {
        if (navigator.doNotTrack === '1') return;
        const body = JSON.stringify({ path: location.pathname, referrer: document.referrer || '' });
        navigator.sendBeacon(`${pbBase}/api/track-view`, new Blob([body], { type: 'application/json' }));
      } catch (_) {}
    };
    // astro:page-load 在首次加载与每次客户端导航都会触发，
    // 挂一次监听器即可覆盖所有 pageview，不再单独立即 send（否则双倍计数）。
    if (!window.__pvBeaconBound) {
      window.__pvBeaconBound = true;
      document.addEventListener('astro:page-load', send);
    }
  })();
</script>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

