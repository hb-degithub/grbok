---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/posts/PostList';
import HomeAuthQuickEntry from '../components/auth/HomeAuthQuickEntry';
import HomeSideNav from '../components/sidebar/HomeSideNav';
import StatusMini from '../components/sidebar/StatusMini';
import HotArticles from '../components/sidebar/HotArticles';
import RecentComments from '../components/sidebar/RecentComments';
import FriendLinks from '../components/sidebar/FriendLinks';
import ProfileCard from '../components/sidebar/ProfileCard';
import CountUp from '../components/reactbits/CountUp';
import { cachedFetchJson } from '../lib/pb-cache';
import { SITE_CONFIG } from '../config/site';
import { pbBaseUrl } from '../lib/pb-base-url';

const PB_URL = pbBaseUrl();

async function fetchCount(collection: string, filter?: string): Promise<number> {
  try {
    const qs = filter ? `?filter=${encodeURIComponent(filter)}&perPage=1` : '?perPage=1';
    const data = await cachedFetchJson<{ totalItems?: number }>(
      `${PB_URL}/api/collections/${collection}/records${qs}`,
      { signal: AbortSignal.timeout(3000) },
      60_000,
    );
    return data.totalItems ?? 0;
  } catch {
    return 0;
  }
}

const [postsCount, tagsCount] = await Promise.all([
  fetchCount('posts', 'status = "published"'),
  fetchCount('tags'),
]);

/**
 * 站点结构拓扑：节点全部是本页可点到的站内真实路由，没有任何占位数据。
 * 计数只复用上面同一次 SSR 计数结果（postsCount / tagsCount）；
 * fetchCount 抓取失败时返回 0，此时不渲染计数——宁可不写，也不把「取不到」显示成 0。
 * 数组顺序即结构顺序：第 1 项是根（首页），其余是它的直接子级（一级栏目）。
 */
interface SiteNodeLink {
  href: string;
  name: string;
  path: string;
  detail: string | null;
  current: boolean;
}

const siteNodes: SiteNodeLink[] = [
  { href: '/', name: '首页', path: '/', detail: null, current: true },
  { href: '/posts', name: '文章', path: '/posts', detail: postsCount > 0 ? `${postsCount} 篇` : null, current: false },
  { href: '/tags', name: '标签', path: '/tags', detail: tagsCount > 0 ? `${tagsCount} 个` : null, current: false },
  { href: '/archive', name: '归档', path: '/archive', detail: null, current: false },
  { href: '/about', name: '关于', path: '/about', detail: null, current: false },
  { href: '/login', name: '登录', path: '/login', detail: null, current: false },
];
---

<BaseLayout title="首页" description={SITE_CONFIG.description} mainClass="pt-0 sm:pt-0 sm:pb-0">
  <!-- 科幻简约 Hero：左文 + 右侧站点结构拓扑 -->
  <section class="sf-hero relative w-full overflow-hidden border-b border-[var(--sf-line)]">
    <div class="sf-grid-bg" aria-hidden="true"></div>
    <div class="mx-auto grid max-w-[1180px] gap-12 px-[var(--sf-pad)] pb-20 pt-[calc(var(--header-offset,4rem)+3rem)] lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:gap-16 lg:pb-28 lg:pt-[calc(var(--header-offset,4rem)+4rem)]">
      <!-- 左侧文案 -->
      <div class="min-w-0">
        <div class="sf-scale mb-6 flex items-end gap-3" aria-hidden="true">
          <span class="sf-scale__ticks"></span>
          <span class="sf-scale__label">LAB / 01</span>
        </div>
        <p class="sf-eyebrow mb-4 flex items-center gap-2 font-mono text-[0.6875rem] uppercase tracking-[0.16em] text-[var(--sf-ink-3)]">
          <span class="sf-dot"></span>
          PERSONAL TECH LOG / 个人技术博客
        </p>
        <h1 class="sf-title break-words text-[clamp(2.5rem,8vw,4.5rem)] font-bold leading-[1.04] tracking-[-0.02em] text-[var(--sf-ink)] [overflow-wrap:anywhere]">
          {SITE_CONFIG.name}
        </h1>
        <p class="sf-lead mt-6 max-w-[32ch] text-[clamp(1.0625rem,2.2vw,1.375rem)] leading-[1.6] text-[var(--sf-ink-2)]">
          {SITE_CONFIG.slogan}<span class="font-medium text-[var(--sf-ink)]">。把折腾过的东西写清楚。</span>
        </p>
        <p class="sf-note mt-4 max-w-[44ch] text-[0.9375rem] leading-[1.75] text-[var(--sf-ink-3)]">
          {SITE_CONFIG.description}
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href="/posts" class="sf-btn-primary inline-flex min-h-[48px] items-center justify-center gap-2 rounded-[4px] bg-[var(--sf-accent)] px-6 text-[0.9375rem] font-medium text-[var(--sf-on-accent)] no-underline transition-[transform,background-color] hover:-translate-y-px hover:bg-[var(--sf-accent-ink)]">
            浏览全部文章 <span class="font-mono text-sm" aria-hidden="true">→</span>
          </a>
          <a href="/about" class="sf-btn-ghost inline-flex min-h-[48px] items-center justify-center rounded-[4px] border border-[var(--sf-line-control)] bg-[var(--sf-surface)] px-6 text-[0.9375rem] font-medium text-[var(--sf-ink)] no-underline transition-[transform,border-color,color] hover:-translate-y-px hover:border-[var(--sf-accent)] hover:text-[var(--sf-accent-ink)]">
            关于这个站点
          </a>
        </div>
        <p class="mt-10 flex flex-wrap items-center gap-2 border-t border-[var(--sf-line-soft)] pt-4 font-mono text-[0.6875rem] uppercase tracking-[0.14em] text-[var(--sf-ink-3)]">
          <span>SINCE {SITE_CONFIG.since}</span>
          <span class="text-[var(--sf-line-strong)]" aria-hidden="true">/</span>
          <span>技术 · 思考 · 生活</span>
        </p>
      </div>

      <!-- 右侧站点结构拓扑：节点是站内真实路由，计数复用本页 SSR 数据，连线是真实层级 -->
      <figure class="sf-figure relative mx-auto w-full max-w-[23rem]">
        <div class="sf-instrument relative w-full border border-[var(--sf-line)] bg-[var(--sf-surface)] p-5 sm:p-6">
          <span class="sf-corner sf-corner-tl" aria-hidden="true"></span>
          <span class="sf-corner sf-corner-tr" aria-hidden="true"></span>
          <span class="sf-corner sf-corner-bl" aria-hidden="true"></span>
          <span class="sf-corner sf-corner-br" aria-hidden="true"></span>
          <div class="mb-4 flex items-baseline justify-between gap-3 border-b border-[var(--sf-line-soft)] pb-2">
            <span class="sf-instrument-label font-mono text-[0.625rem] uppercase tracking-[0.2em] text-[var(--sf-ink-3)]">SITEMAP / 01</span>
            <span class="font-mono text-[0.625rem] uppercase tracking-[0.14em] text-[var(--sf-ink-3)]">{siteNodes.length} NODES</span>
          </div>
          <div class="sf-sitemap">
            {/* 连线只负责画层级关系（root → 一级栏目），语义由下面的 <ol>/<a> 提供；
                连线坐标与节点百分比一一对应，改坐标时两边要同步。 */}
            <svg class="sf-sitemap__wires" viewBox="0 0 360 360" fill="none" aria-hidden="true" focusable="false">
              <path
                d="M104 180H128M128 48V312M128 48H152M128 114H152M128 180H152M128 246H152M128 312H152"
                stroke="var(--sf-line-strong)"
                stroke-width="1"
                vector-effect="non-scaling-stroke"></path>
            </svg>
            <ol class="sf-sitemap__list" role="list">
              {siteNodes.map((node) => (
                <li class:list={['sf-sitemap__item', node.current && 'sf-sitemap__item--current']}>
                  <a
                    href={node.href}
                    class="sf-sitemap__link"
                    aria-current={node.current ? 'page' : undefined}
                  >
                    <span class="sf-sitemap__name">{node.name}</span>
                    <span class="sf-sitemap__meta">
                      <span class="sf-sitemap__path">{node.path}</span>
                      {node.detail && (
                        <>
                          <span class="sf-sitemap__sep" aria-hidden="true">·</span>
                          <span class="sf-sitemap__count">{node.detail}</span>
                        </>
                      )}
                      {node.current && (
                        <>
                          <span class="sf-sitemap__sep" aria-hidden="true">·</span>
                          <span class="sf-sitemap__flag">当前页</span>
                        </>
                      )}
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </div>
        <figcaption class="mt-3 text-center font-mono text-[0.625rem] text-[var(--sf-ink-3)]">站点结构 · 真实入口 · 首页为根，其余为一级栏目</figcaption>
      </figure>
    </div>
  </section>

  <!-- 最新文章 -->
  <section id="latest" class="w-full border-b border-[var(--sf-line)]">
    <div class="mx-auto max-w-[1180px] px-[var(--sf-pad)] py-16 lg:py-24">
      <div class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="font-mono text-[0.6875rem] uppercase tracking-[0.16em] text-[var(--sf-ink-3)]">02 / 最新文章</p>
          <h2 class="mt-2 text-3xl font-bold tracking-tight text-[var(--sf-ink)]">最新文章</h2>
          <p class="mt-2 text-sm text-[var(--sf-ink-2)]">最近发布的技术文章和思考。</p>
        </div>
        <a href="/posts" class="sf-link inline-flex min-h-[44px] w-fit items-center gap-1.5 font-mono text-sm text-[var(--sf-accent)] no-underline transition-colors hover:text-[var(--sf-accent-ink)]">
          查看全部 <span aria-hidden="true">→</span>
        </a>
      </div>
      <PostList client:visible perPage={6} />
    </div>
  </section>

  <!-- 热榜与最近评论：保留真实数据源，编号行列表替代旧侧栏浮动组件 -->
  <section id="community" class="w-full border-b border-[var(--sf-line)]">
    <div class="mx-auto grid max-w-[1180px] gap-6 px-[var(--sf-pad)] py-16 lg:grid-cols-2 lg:gap-8 lg:py-24">
      <div class="sf-block">
        <HotArticles client:visible />
      </div>
      <div class="sf-block">
        <RecentComments client:visible />
      </div>
    </div>
  </section>

  <!-- 作者与友链：恢复改版中丢失的两个内容块，沿用与「热榜文章 / 最近评论」相同的两栏细线面板 -->
  <section id="connect" class="w-full border-b border-[var(--sf-line)]">
    <div class="mx-auto max-w-[1180px] px-[var(--sf-pad)] py-16 lg:py-24">
      <div class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="font-mono text-[0.6875rem] uppercase tracking-[0.16em] text-[var(--sf-ink-3)]">03 / 作者与友链</p>
          <h2 class="mt-2 text-3xl font-bold tracking-tight text-[var(--sf-ink)]">作者与友链</h2>
          <p class="mt-2 text-sm text-[var(--sf-ink-2)]">关于博主，以及长期互访的站点。</p>
        </div>
        <a href="/links" class="sf-link inline-flex min-h-[44px] w-fit items-center gap-1.5 font-mono text-sm text-[var(--sf-accent)] no-underline transition-colors hover:text-[var(--sf-accent-ink)]">
          全部友链 <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="grid gap-6 lg:grid-cols-2 lg:gap-8">
        <div class="sf-block">
          <ProfileCard client:visible />
        </div>
        <div class="sf-block">
          <FriendLinks client:visible />
        </div>
      </div>
    </div>
  </section>

  <!-- 侧栏信息合并 -->
  <section class="w-full border-b border-[var(--sf-line)]">
    <div class="mx-auto grid max-w-[1180px] gap-8 px-[var(--sf-pad)] py-16 lg:grid-cols-3 lg:py-24">
      <div class="sf-panel">
        <h3 class="sf-panel-title">站内导航</h3>
        <HomeSideNav client:visible />
      </div>
      <div class="sf-panel">
        <h3 class="sf-panel-title">站点状态</h3>
        <StatusMini client:visible />
        <div class="mt-4 grid grid-cols-2 gap-4 border-t border-[var(--sf-line-soft)] pt-4">
          <div><div class="text-2xl font-bold text-[var(--sf-ink)]"><CountUp client:visible to={postsCount} duration={1.5} /></div><div class="text-xs text-[var(--sf-ink-3)]">已发布文章</div></div>
          <div><div class="text-2xl font-bold text-[var(--sf-ink)]"><CountUp client:visible to={tagsCount} duration={1.5} /></div><div class="text-xs text-[var(--sf-ink-3)]">内容标签</div></div>
        </div>
      </div>
      <div class="sf-panel">
        <h3 class="sf-panel-title">快速入口</h3>
        <HomeAuthQuickEntry client:visible />
        <a href="/about" class="sf-link mt-4 inline-flex min-h-[44px] items-center gap-1.5 font-mono text-sm text-[var(--sf-accent)] no-underline transition-colors hover:text-[var(--sf-accent-ink)]">
          关于博主 <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* 科幻简约首页局部样式；设计令牌统一由 global.css 提供。 */
  .sf-hero {
    background: var(--sf-canvas);
  }

  .sf-grid-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      repeating-linear-gradient(to right, rgba(22, 25, 29, 0.045) 0 1px, transparent 1px 32px),
      repeating-linear-gradient(to bottom, rgba(22, 25, 29, 0.045) 0 1px, transparent 1px 32px);
    mask-image: linear-gradient(to bottom, black 0%, transparent 80%);
  }

  :global(.dark) .sf-grid-bg {
    background-image:
      repeating-linear-gradient(to right, rgba(232, 236, 240, 0.04) 0 1px, transparent 1px 32px),
      repeating-linear-gradient(to bottom, rgba(232, 236, 240, 0.04) 0 1px, transparent 1px 32px);
  }

  .sf-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sf-accent);
  }

  .sf-scale__ticks {
    flex: 1;
    height: 7px;
    border-bottom: 1px solid var(--sf-line-strong);
    background-image: repeating-linear-gradient(to right, var(--sf-line-strong) 0 1px, transparent 1px 12px);
    background-size: 100% 8px;
    background-repeat: no-repeat;
    background-position: bottom left;
  }

  .sf-scale__label {
    font-family: 'Geist Mono', monospace;
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    color: var(--sf-ink-3);
  }

  /* 站点结构面板；结构线由内联 SVG 画在底层，节点文字是 HTML 叠加在上层，
     因此文字不随图形缩放、不会发虚。 */
  .sf-instrument {
    position: relative;
  }

  /* 四个角标：边框简写显式带 var(--sf-line-strong)。
     若只写 `border-top: 1px solid`，简写会把 color 重置为 currentColor，
     暗色主题下线条会变成近白（.sf-corner 上的 border-color 被覆盖）。 */
  .sf-corner {
    position: absolute;
    width: 12px;
    height: 12px;
    border-color: var(--sf-line-strong);
  }

  .sf-corner-tl { top: -1px; left: -1px; border-top: 1px solid var(--sf-line-strong); border-left: 1px solid var(--sf-line-strong); }
  .sf-corner-tr { top: -1px; right: -1px; border-top: 1px solid var(--sf-line-strong); border-right: 1px solid var(--sf-line-strong); }
  .sf-corner-bl { bottom: -1px; left: -1px; border-bottom: 1px solid var(--sf-line-strong); border-left: 1px solid var(--sf-line-strong); }
  .sf-corner-br { bottom: -1px; right: -1px; border-bottom: 1px solid var(--sf-line-strong); border-right: 1px solid var(--sf-line-strong); }

  /* 站点结构拓扑
     - 小屏（<640px）：纵向列表 + 左侧竖线（每条 li 的 border-left 拼成一条主干），
       短横线是「同属根节点一级栏目」的层级提示。
     - 桌面（≥640px）：同一个 <ol> 按 360×360 坐标系绝对定位到方形舞台，
       连线由上方 <svg> 画在底层；两者百分比与 SVG 坐标一一对应。 */
  .sf-sitemap__wires {
    display: none;
  }

  .sf-sitemap__list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sf-sitemap__item {
    position: relative;
    padding: 4px 0 4px 1.125rem;
    border-left: 1px solid var(--sf-line-strong);
  }

  .sf-sitemap__item::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 0.6875rem;
    height: 1px;
    background: var(--sf-line-strong);
  }

  /* 可点区域在移动端保持 ≥44px（min-height: 48px） */
  .sf-sitemap__link {
    display: flex;
    min-height: 48px;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--sf-line);
    border-radius: 3px;
    background: var(--sf-surface);
    color: var(--sf-ink);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  /* 当前页用强调色描边区分（另有 aria-current="page" 与「当前页」文字，不只靠颜色） */
  .sf-sitemap__item--current .sf-sitemap__link {
    border-color: var(--sf-accent);
  }

  .sf-sitemap__link:hover {
    border-color: var(--sf-accent);
  }

  .sf-sitemap__link:focus-visible {
    border-color: var(--sf-accent);
    outline: 2px solid var(--sf-accent);
    outline-offset: 2px;
  }

  .sf-sitemap__name {
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .sf-sitemap__meta {
    display: inline-flex;
    min-width: 0;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3em;
    font-family: 'Geist Mono', monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--sf-ink-3);
  }

  .sf-sitemap__sep {
    color: var(--sf-line-strong);
  }

  .sf-sitemap__count {
    font-variant-numeric: tabular-nums;
    color: var(--sf-ink-2);
  }

  .sf-sitemap__flag {
    color: var(--sf-accent);
    letter-spacing: 0.12em;
  }

  @media (min-width: 640px) {
    .sf-sitemap {
      position: relative;
      width: 100%;
      aspect-ratio: 1 / 1;
    }

    .sf-sitemap__wires {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }

    .sf-sitemap__list {
      position: absolute;
      inset: 0;
    }

    .sf-sitemap__item {
      position: absolute;
      margin: 0;
      padding: 0;
      border-left: 0;
    }

    .sf-sitemap__item::before {
      display: none;
    }

    /* 根节点：首页（当前页），左侧垂直居中；右边缘正好接上 SVG 的连接线 */
    .sf-sitemap__item:nth-child(1) {
      top: 41.6667%;
      left: 0;
      width: 28.8889%;
      height: 16.6667%;
    }

    /* 一级栏目：右侧竖排，共用一列宽度与行高 */
    .sf-sitemap__item:nth-child(n + 2) {
      left: 42.2222%;
      width: 57.7778%;
      height: 14.4444%;
    }

    .sf-sitemap__item:nth-child(2) { top: 6.1111%; }
    .sf-sitemap__item:nth-child(3) { top: 24.4444%; }
    .sf-sitemap__item:nth-child(4) { top: 42.7778%; }
    .sf-sitemap__item:nth-child(5) { top: 61.1111%; }
    .sf-sitemap__item:nth-child(6) { top: 79.4444%; }

    .sf-sitemap__link {
      height: 100%;
      min-height: 0;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 1px;
      padding: 0.25rem 0.625rem;
    }

    .sf-sitemap__meta {
      font-size: 0.625rem;
      letter-spacing: 0.03em;
    }
  }

  /* 面板 */
  .sf-panel {
    border-left: 2px solid var(--sf-accent);
    padding-left: 1.25rem;
  }

  .sf-panel-title {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--sf-ink);
    margin-bottom: 1rem;
  }

  .sf-link {
    text-decoration: none;
  }
</style>
