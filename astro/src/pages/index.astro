---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import SectionHeading from '../components/layout/SectionHeading.astro';
import PostList from '../components/posts/PostList';
import HomeAuthQuickEntry from '../components/auth/HomeAuthQuickEntry';
import HomeSideNav from '../components/sidebar/HomeSideNav';
import StatusMini from '../components/sidebar/StatusMini';
import HotArticles from '../components/sidebar/HotArticles';
import RecentComments from '../components/sidebar/RecentComments';
import FriendLinks from '../components/sidebar/FriendLinks';
import ProfileCard from '../components/sidebar/ProfileCard';
import CountUp from '../components/reactbits/CountUp';
import { cachedFetchJson } from '../lib/pb-cache';
import { SITE_CONFIG } from '../config/site';
import { pbBaseUrl } from '../lib/pb-base-url';

const PB_URL = pbBaseUrl();

async function fetchCount(collection: string, filter?: string): Promise<number> {
  try {
    const qs = filter ? `?filter=${encodeURIComponent(filter)}&perPage=1` : '?perPage=1';
    const data = await cachedFetchJson<{ totalItems?: number }>(
      `${PB_URL}/api/collections/${collection}/records${qs}`,
      { signal: AbortSignal.timeout(3000) },
      60_000,
    );
    return data.totalItems ?? 0;
  } catch {
    return 0;
  }
}

const [postsCount, tagsCount] = await Promise.all([
  fetchCount('posts', 'status = "published"'),
  fetchCount('tags'),
]);
---

<BaseLayout title="首页" description={SITE_CONFIG.description} mainClass="pt-0 sm:pt-0 sm:pb-0">
  <HomeHero />

  <!-- 最新文章：左侧分区索引 + 右侧内容，先建立「轨道日志」的分栏层次 -->
  <section id="latest" class="home-section" aria-labelledby="latest-title">
    <div class="orbital-shell">
      <SectionHeading
        id="latest-title"
        eyebrow="02 / 最新文章"
        title="最新文章"
        description="最近发布的技术文章和思考。"
      >
        <a slot="action" href="/posts" class="orbital-action">
          查看全部 <span aria-hidden="true">→</span>
        </a>
      </SectionHeading>

      <div class="mt-8 grid gap-8 lg:mt-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:items-start lg:gap-12">
        <aside class="orbital-panel min-w-0" aria-label="首页分区导航">
          <p class="home-index-note">SECTION INDEX</p>
          <HomeSideNav client:visible />
        </aside>
        <div class="min-w-0">
          <PostList client:visible perPage={6} />
        </div>
      </div>
    </div>
  </section>

  <!-- 热榜与最近评论：两栏错位，保留真实数据源与编号行列表 -->
  <section id="community" class="home-section" aria-labelledby="community-title">
    <div class="orbital-shell">
      <SectionHeading
        id="community-title"
        eyebrow="03 / 社区切片"
        title="热榜与最近评论"
        description="被读得最多的文章，以及刚刚发生的讨论。"
      />

      <div class="mt-8 grid gap-6 lg:mt-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-start lg:gap-10">
        <div class="orbital-panel min-w-0">
          <HotArticles client:visible />
        </div>
        <div class="orbital-panel min-w-0 lg:mt-10">
          <RecentComments client:visible />
        </div>
      </div>
    </div>
  </section>

  <!-- 作者与友链：非对称两栏，避免回到旧的等宽侧栏拼接 -->
  <section id="connect" class="home-section" aria-labelledby="connect-title">
    <div class="orbital-shell">
      <SectionHeading
        id="connect-title"
        eyebrow="04 / 作者与友链"
        title="作者与友链"
        description="关于博主，以及长期互访的站点。"
      >
        <a slot="action" href="/links" class="orbital-action">
          全部友链 <span aria-hidden="true">→</span>
        </a>
      </SectionHeading>

      <div class="home-connect-grid mt-8 grid gap-6 md:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] md:items-start lg:mt-10">
        <div class="orbital-panel min-w-0">
          <ProfileCard client:visible />
        </div>
        <div class="orbital-panel min-w-0 md:mt-12">
          <FriendLinks client:visible />
        </div>
      </div>
    </div>
  </section>

  <!-- 运行与入口：状态、计数、账户入口分三栏，计数仍由本页 SSR 取数 -->
  <section id="status" class="home-section" aria-labelledby="status-title">
    <div class="orbital-shell">
      <SectionHeading
        id="status-title"
        eyebrow="05 / 运行与入口"
        title="站点状态与快速入口"
        description="公开状态、内容计数与账户入口，全部来自真实接口。"
      />

      <div class="mt-8 grid gap-6 lg:mt-10 lg:grid-cols-[1.15fr_0.85fr_1fr] lg:items-start">
        <div class="orbital-panel min-w-0">
          <h3 class="home-panel-title">站点状态</h3>
          <StatusMini client:visible />
        </div>

        <div class="orbital-panel min-w-0 lg:mt-10">
          <h3 class="home-panel-title">内容计数</h3>
          <div class="grid grid-cols-2 gap-6">
            <div>
              <div class="home-count"><CountUp client:visible to={postsCount} duration={1.5} /></div>
              <div class="home-count-label">已发布文章</div>
            </div>
            <div>
              <div class="home-count"><CountUp client:visible to={tagsCount} duration={1.5} /></div>
              <div class="home-count-label">内容标签</div>
            </div>
          </div>
        </div>

        <div class="orbital-panel min-w-0">
          <h3 class="home-panel-title">快速入口</h3>
          <HomeAuthQuickEntry client:visible />
          <a
            href="/about"
            class="orbital-action mt-4 inline-flex"
          >
            关于博主 <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* 首页分区只负责节奏与分隔线；颜色/间距令牌统一来自 global.css。 */
  .home-section {
    border-bottom: 1px solid var(--sf-line);
    scroll-margin-top: calc(var(--header-offset, 4rem) + 1rem);
  }

  /* 友链为空时 FriendLinks 返回 null，只留下一个空的 astro-island。
     这里隐藏空面板并让作者卡占满整行，避免首页出现一条空白白条。 */
  .home-connect-grid > .orbital-panel:has(> astro-island:empty) {
    display: none;
  }

  .home-connect-grid:has(> .orbital-panel > astro-island:empty) {
    grid-template-columns: minmax(0, 1fr);
  }

  /* 单列时不要把作者卡拉成整行宽：限制阅读宽度，右侧留白。 */
  .home-connect-grid:has(> .orbital-panel > astro-island:empty) > .orbital-panel:first-child {
    max-width: 36rem;
  }

  .home-index-note {
    margin: 0 0 0.875rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    line-height: 1.4;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--sf-ink-3);
  }

  .home-panel-title {
    margin: 0 0 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.05em;
    color: var(--sf-ink);
  }

  .home-count {
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--sf-ink);
    font-variant-numeric: tabular-nums;
  }

  .home-count-label {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.4;
    letter-spacing: 0.08em;
    color: var(--sf-ink-3);
  }
</style>
