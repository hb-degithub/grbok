---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../components/layout/PageShell.astro';
import StatusPanel from '../components/status/StatusPanel';
import ProtectionPanel from '../components/status/ProtectionPanel';
---

<BaseLayout title="运行状态" description="站点服务可用性、API 状态与你的访问延迟实时监测">
  {/* 展示页统一外壳：页头交给 PageShell，状态场景仍由真实探针数据驱动。 */}
  <div class="mx-auto w-full max-w-5xl">
    <PageShell
      eyebrow="Status / 01"
      title="运行状态"
      description="站内探针每分钟对页面、API 与邮件网关做一次可达性采样，页面每 30 秒自动刷新；延迟卡片由你的浏览器实时实测。"
    >
      <StatusPanel client:load />
      <div id="protection">
        <ProtectionPanel client:load />
      </div>
    </PageShell>
  </div>
</BaseLayout>
