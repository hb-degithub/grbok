---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollReveal from '../components/ui/ScrollReveal';
import Starfield from '../components/effects/Starfield';
---

<BaseLayout title="404" description="页面未找到">
  <div class="pointer-events-none fixed inset-0 z-0 hidden dark:block" aria-hidden="true">
    <Starfield client:visible />
  </div>
  <section class="relative z-10 mx-auto flex min-h-[60vh] w-full max-w-3xl items-center px-[var(--sf-pad)] py-16">
    <ScrollReveal client:visible className="w-full">
      <div class="border-y border-[var(--sf-line)] py-16 text-center">
        <p class="mb-6 flex items-center justify-center gap-3 font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--sf-ink-3)]">
          <span class="h-px w-8 bg-[var(--sf-line-strong)]" aria-hidden="true"></span>
          Error / 404
        </p>

        <h1
          class="font-mono text-[clamp(4rem,16vw,7rem)] font-bold leading-[0.9] tracking-[-0.05em] tabular-nums text-[var(--sf-ink)]"
        >
          404
        </h1>
        <p class="mt-6 text-xl font-semibold tracking-tight text-[var(--sf-ink)]">页面未找到</p>
        <p class="mt-2 text-sm text-[var(--sf-ink-2)]">抱歉，您访问的页面不存在</p>

        <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a
            href="/"
            class="inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-[3px] border border-[var(--sf-accent)] px-5 font-mono text-xs uppercase tracking-[0.14em] text-[var(--sf-accent-ink)] no-underline transition-colors duration-200 hover:bg-[var(--sf-accent)] hover:text-[var(--sf-canvas)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sf-accent)] sm:w-auto"
          >
            返回首页
          </a>
          <a
            href="/posts"
            class="inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-[3px] border border-[var(--sf-line-control)] px-5 font-mono text-xs uppercase tracking-[0.14em] text-[var(--sf-ink-2)] no-underline transition-colors duration-200 hover:border-[var(--sf-accent)] hover:text-[var(--sf-accent-ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sf-accent)] sm:w-auto"
          >
            浏览文章
          </a>
        </div>
      </div>
    </ScrollReveal>
  </section>
</BaseLayout>
