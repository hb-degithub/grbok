---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="访问受限" description="您的请求被安全策略拦截" noindex>
  <section class="relative z-10 mx-auto w-full max-w-3xl px-[var(--sf-pad)] py-16 sm:py-20">
    <header class="border-b border-[var(--sf-line)] pb-8">
      <p class="mb-4 flex items-center gap-3 font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--sf-ink-3)]">
        <span class="h-px w-8 bg-[var(--sf-line-strong)]" aria-hidden="true"></span>
        Security / 拦截
      </p>

      {/* 图标 + 标题 + 描述 */}
      <div class="flex items-start gap-4">
        <div class="flex h-11 w-11 shrink-0 items-center justify-center border border-[var(--sf-line-strong)] bg-[var(--sf-surface)]">
          <svg class="h-5 w-5 text-[var(--sf-ink-3)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <div class="min-w-0">
          <h1 class="text-3xl font-bold tracking-tight text-[var(--sf-ink)] sm:text-4xl">访问受限</h1>
          <p class="mt-2 max-w-md text-sm leading-relaxed text-[var(--sf-ink-2)]">
            您的请求被安全策略拦截。如果您认为这是误判，请联系网站管理员。
          </p>
        </div>
      </div>
    </header>

    {/* 拦截信息 */}
    <div class="mt-10">
      <p class="mb-3 font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--sf-ink-3)]">Readout / 拦截信息</p>
      <div class="border-y border-[var(--sf-line)]">
        <div class="flex items-baseline justify-between gap-4 border-b border-[var(--sf-line-soft)] py-3">
          <span class="shrink-0 font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--sf-ink-2)]">请求 ID</span>
          <span class="min-w-0 truncate font-mono text-[11px] tabular-nums text-[var(--sf-ink-3)]" id="requestId">-</span>
        </div>
        <div class="flex items-baseline justify-between gap-4 border-b border-[var(--sf-line-soft)] py-3">
          <span class="shrink-0 font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--sf-ink-2)]">拦截原因</span>
          <span class="min-w-0 truncate font-mono text-[11px] text-[var(--sf-ink-3)]" id="blockReason">安全策略</span>
        </div>
        <div class="flex items-baseline justify-between gap-4 py-3">
          <span class="shrink-0 font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--sf-ink-2)]">时间</span>
          <span class="min-w-0 truncate font-mono text-[11px] tabular-nums text-[var(--sf-ink-3)]" id="blockTime">-</span>
        </div>
      </div>
    </div>

    {/* 操作按钮 */}
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a
        href="/"
        class="inline-flex min-h-11 items-center justify-center gap-2 rounded-[3px] border border-[var(--sf-accent)] px-5 font-mono text-xs uppercase tracking-[0.14em] text-[var(--sf-accent-ink)] no-underline transition-colors duration-200 hover:bg-[var(--sf-accent)] hover:text-[var(--sf-canvas)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sf-accent)]"
      >
        <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        返回首页
      </a>
      <button
        onclick="history.back()"
        class="inline-flex min-h-11 items-center justify-center gap-2 rounded-[3px] border border-[var(--sf-line-control)] px-5 font-mono text-xs uppercase tracking-[0.14em] text-[var(--sf-ink-2)] transition-colors duration-200 hover:border-[var(--sf-accent)] hover:text-[var(--sf-accent-ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sf-accent)]"
      >
        <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        返回上一页
      </button>
    </div>
  </section>

  <script is:inline>
    // 从 URL 参数中获取拦截信息
    (function() {
      const params = new URLSearchParams(window.location.search);
      const requestId = params.get('requestId') || params.get('request_id');
      const reason = params.get('reason') || params.get('rule');
      
      if (requestId) {
        document.getElementById('requestId').textContent = requestId;
      }
      if (reason) {
        document.getElementById('blockReason').textContent = reason;
      }
      document.getElementById('blockTime').textContent = new Date().toLocaleString('zh-CN');
    })();
  </script>
</BaseLayout>
