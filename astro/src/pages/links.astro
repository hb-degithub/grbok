---
import BaseLayout from '../layouts/BaseLayout.astro';
import FriendLinksGrid from '../components/links/FriendLinksGrid';
import FriendLinkLeaderboard from '../components/links/FriendLinkLeaderboard';
---

<BaseLayout title="友情链接" description="朋友们的站点与点击排行">
  <section class="mx-auto w-full max-w-5xl px-5 py-16 sm:px-8 lg:px-10">
    <header class="mb-10 border-b border-[var(--sf-line)] pb-6">
      <p class="mb-3 flex items-center gap-3 font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--sf-ink-3)]">
        <span class="h-px w-8 bg-[var(--sf-line-strong)]" aria-hidden="true"></span>
        Links / 01
      </p>
      <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
        <h1 class="text-4xl font-bold tracking-tight text-[var(--sf-ink)] sm:text-5xl">友情链接</h1>
        <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--sf-ink-3)]">Exchange / 互换</p>
      </div>
      <p class="mt-3 max-w-xl text-[var(--sf-ink-2)]">
        朋友们的站点，欢迎串门。
      </p>
    </header>

    <FriendLinksGrid client:visible />

    <div class="mt-10 grid gap-4 lg:grid-cols-2">
      <FriendLinkLeaderboard client:visible />

      <!-- 申请友链 -->
      <section class="border border-[var(--sf-line)] bg-[var(--sf-surface)] p-5">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--sf-ink-3)]">Apply / 申请</p>
        <h2 class="mt-2 text-sm font-semibold tracking-tight text-[var(--sf-ink)]">申请友链</h2>
        <p class="mt-3 text-sm leading-7 text-[var(--sf-ink-2)]">
          欢迎互换友情链接。请按以下格式发送邮件，通过后会尽快添加：
        </p>
        <ul class="mt-3 list-none space-y-1.5 p-0 text-sm text-[var(--sf-ink-3)]">
          <li>· 站名：你的站点名称</li>
          <li>· 地址：站点 URL（https）</li>
          <li>· 简介：一句话介绍你的站点</li>
        </ul>
        <a
          href="mailto:670486183@qq.com?subject=%E5%8F%8B%E9%93%BE%E7%94%B3%E8%AF%B7"
          class="mt-5 inline-flex min-h-[44px] items-center justify-center gap-2 rounded-[3px] border border-[var(--sf-accent)] px-5 font-mono text-xs uppercase tracking-[0.14em] text-[var(--sf-accent-ink)] no-underline transition-colors duration-200 hover:bg-[var(--sf-accent)] hover:text-[var(--sf-canvas)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sf-accent)]"
        >
          邮件申请 →
        </a>
      </section>
    </div>
  </section>
</BaseLayout>
