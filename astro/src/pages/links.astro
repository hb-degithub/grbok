---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../components/layout/PageShell.astro';
import SectionHeading from '../components/layout/SectionHeading.astro';
import FriendLinksGrid from '../components/links/FriendLinksGrid';
import FriendLinkLeaderboard from '../components/links/FriendLinkLeaderboard';
---

<BaseLayout title="友情链接" description="朋友们的站点与点击排行">
  {/* 展示页统一外壳：PageShell 负责页头，区块标题与面板统一到轨道日志原语。 */}
  <div class="mx-auto w-full max-w-5xl">
    <PageShell
      eyebrow="Links / 01"
      title="友情链接"
      description="朋友们的站点，欢迎串门。"
    >
      <SectionHeading
        id="friend-links-list"
        eyebrow="Exchange / 互换"
        level="h2"
        title="朋友们的站点"
        description="按最近更新展示；点击卡片会在新标签打开并记录一次点击。"
      />
      <FriendLinksGrid client:visible />

      <div class="grid gap-4 lg:grid-cols-2">
        <FriendLinkLeaderboard client:visible />

        <section class="orbital-panel" aria-labelledby="friend-links-apply">
          <p class="orbital-eyebrow">Apply / 申请</p>
          <h2 id="friend-links-apply" class="orbital-heading__title mt-2">申请友链</h2>
          <p class="mt-3 text-sm leading-7 text-[var(--sf-ink-2)]">
            欢迎互换友情链接。请按以下格式发送邮件，通过后会尽快添加：
          </p>
          <ul class="mt-3 list-none space-y-1.5 p-0 text-sm text-[var(--sf-ink-3)]">
            <li>· 站名：你的站点名称</li>
            <li>· 地址：站点 URL（https）</li>
            <li>· 简介：一句话介绍你的站点</li>
          </ul>
          <a
            href="mailto:670486183@qq.com?subject=%E5%8F%8B%E9%93%BE%E7%94%B3%E8%AF%B7"
            class="orbital-action mt-5 min-h-11 no-underline"
          >
            邮件申请 →
          </a>
        </section>
      </div>
    </PageShell>
  </div>
</BaseLayout>
