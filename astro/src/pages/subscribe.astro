---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeedCopyButton from '../components/subscribe/FeedCopyButton';

const feedUrl = new URL('/feed.xml', Astro.site).href;

const readers = [
  { name: 'Feedly', url: 'https://feedly.com/', desc: '最主流的在线 RSS 阅读器，网页/手机都能用' },
  { name: 'Inoreader', url: 'https://www.inoreader.com/', desc: '功能全面的阅读器，支持过滤与规则' },
  { name: 'NetNewsWire', url: 'https://netnewswire.com/', desc: '苹果生态免费开源阅读器' },
];
---

<BaseLayout title="订阅" description="通过 RSS 订阅博客更新">
  <section class="mx-auto w-full max-w-3xl px-5 py-16 sm:px-8">
    <header class="mb-10 border-b border-[var(--sf-line)] pb-6">
      <p class="mb-3 flex items-center gap-3 font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--sf-ink-3)]">
        <span class="h-px w-8 bg-[var(--sf-line-strong)]" aria-hidden="true"></span>
        Subscribe / 01
      </p>
      <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
        <h1 class="text-4xl font-bold tracking-tight text-[var(--sf-ink)] sm:text-5xl">订阅</h1>
        <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--sf-ink-3)]">RSS / XML</p>
      </div>
      <p class="mt-3 max-w-xl text-[var(--sf-ink-2)]">通过 RSS 订阅，新文章会第一时间出现在你的阅读器里。</p>
    </header>

    <div class="grid gap-4">
      <section class="rounded-[3px] border border-[var(--sf-line)] bg-[var(--sf-surface)] p-5 sm:p-6">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--sf-ink-3)]">Feed / 01</p>
        <h2 class="mt-2 text-lg font-semibold tracking-tight text-[var(--sf-ink)]">RSS 订阅地址</h2>
        <p class="mt-2 text-sm leading-7 text-[var(--sf-ink-2)]">
          RSS 是一种内容订阅协议。把下面的地址粘贴到任意 RSS 阅读器，即可订阅本博客的全部文章。
        </p>

        <div class="mt-4 flex items-center gap-2 rounded-[3px] border border-[var(--sf-line)] bg-[var(--sf-canvas)] px-3 py-2.5">
          <svg class="h-4 w-4 shrink-0 text-[var(--sf-accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 5c7.18 0 13 5.82 13 13M6 11a7 7 0 017 7m-6 0a1 1 0 11-2 0 1 1 0 012 0z" />
          </svg>
          <code class="min-w-0 flex-1 truncate font-mono text-xs text-[var(--sf-ink-2)]">{feedUrl}</code>
        </div>

        <div class="mt-4 flex flex-wrap items-center gap-3">
          <FeedCopyButton client:load url={feedUrl} />
          <a
            href="/feed.xml"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-[44px] items-center rounded-[3px] border border-[var(--sf-line-control)] px-4 font-mono text-xs uppercase tracking-[0.14em] text-[var(--sf-ink-2)] no-underline transition-colors duration-200 hover:border-[var(--sf-accent)] hover:text-[var(--sf-accent-ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sf-accent)]"
          >
            打开 feed.xml
          </a>
        </div>
      </section>

      <section class="rounded-[3px] border border-[var(--sf-line)] bg-[var(--sf-surface)] p-5 sm:p-6">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--sf-ink-3)]">Readers / 02</p>
        <h2 class="mt-2 text-lg font-semibold tracking-tight text-[var(--sf-ink)]">推荐阅读器</h2>

        <div class="mt-4 grid gap-3 sm:grid-cols-3">
          {readers.map((reader) => (
            <a
              href={reader.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex flex-col rounded-[3px] border border-[var(--sf-line)] p-4 no-underline transition-colors duration-200 hover:border-[var(--sf-accent)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sf-accent)]"
            >
              <span class="text-sm font-semibold text-[var(--sf-ink)] transition-colors duration-200 group-hover:text-[var(--sf-accent-ink)]">
                {reader.name}
              </span>
              <span class="mt-1 text-xs leading-5 text-[var(--sf-ink-3)]">{reader.desc}</span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </section>
</BaseLayout>
