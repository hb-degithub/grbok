---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects, type Project } from '../config/projects';

const featured = projects.filter((p) => p.featured);
const regular = projects.filter((p) => !p.featured);

/** 状态徽标只走共享令牌：单一强调色 + 冷灰细线区分语义，不再引入第二套调色板。 */
const statusMeta: Record<Project['status'], { label: string; className: string }> = {
  active: { label: '运营中', className: 'border-[var(--sf-accent)] text-[var(--sf-accent-ink)]' },
  wip: { label: '开发中', className: 'border-[var(--sf-line-strong)] text-[var(--sf-ink-2)]' },
  archived: { label: '已归档', className: 'border-[var(--sf-line)] text-[var(--sf-ink-3)]' },
};

/** 两位序号：精选/常规两组的索引都统一等宽对齐。 */
function formatOrdinal(index: number): string {
  return String(index + 1).padStart(2, '0');
}
---

<BaseLayout title="项目" description="我做过的和正在做的项目">
  <section class="mx-auto w-full max-w-5xl px-5 py-16 sm:px-8 lg:px-10">
    <header class="mb-10 border-b border-[var(--sf-line)] pb-6">
      <p class="mb-3 flex items-center gap-3 font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--sf-ink-3)]">
        <span class="h-px w-8 bg-[var(--sf-line-strong)]" aria-hidden="true"></span>
        Projects / 01
      </p>
      <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
        <h1 class="text-4xl font-bold tracking-tight text-[var(--sf-ink)] sm:text-5xl">项目</h1>
        <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--sf-ink-3)]">
          共 {projects.length} 个项目
        </p>
      </div>
      <p class="mt-3 max-w-xl text-[var(--sf-ink-2)]">我做过的和正在做的东西。</p>
    </header>

    {projects.length === 0 ? (
      <div class="border-y border-[var(--sf-line)] px-1 py-16 text-center">
        <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--sf-ink-3)]">Empty / 0</p>
        <p class="mt-3 text-[var(--sf-ink-2)]">还没有项目，去 src/config/projects.ts 添加第一个吧。</p>
      </div>
    ) : (
      <>
        {featured.length > 0 && (
          <div class="mb-12">
            <div class="flex items-baseline justify-between gap-4 border-b border-[var(--sf-line)] pb-2">
              <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--sf-ink-3)]">
                Featured / 精选
              </p>
              <span class="font-mono text-[11px] tabular-nums tracking-[0.1em] text-[var(--sf-ink-3)]">
                {featured.length} 个
              </span>
            </div>

            <div class="mt-4 grid gap-4">
              {featured.map((project, index) => (
                <article class="rounded-[3px] border border-[var(--sf-line)] bg-[var(--sf-surface)] p-5 sm:p-6">
                  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
                    <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--sf-ink-3)]">
                      Featured / F{formatOrdinal(index)}
                    </span>
                    <span
                      class={`inline-flex shrink-0 items-center rounded-[3px] border px-2 py-0.5 text-[11px] tracking-[0.08em] ${statusMeta[project.status].className}`}
                    >
                      {statusMeta[project.status].label}
                    </span>
                  </div>

                  <h2 class="mt-3 text-2xl font-bold tracking-tight text-[var(--sf-ink)] sm:text-3xl">
                    {project.name}
                  </h2>
                  <p class="mt-2 text-sm font-medium text-[var(--sf-ink-2)]">{project.tagline}</p>
                  <p class="mt-3 text-sm leading-7 text-[var(--sf-ink-3)]">{project.description}</p>

                  <ul class="mt-4 flex list-none flex-wrap gap-1.5 p-0" aria-label={`${project.name} 技术栈`}>
                    {project.tech.map((t) => (
                      <li class="rounded-[3px] border border-[var(--sf-line-soft)] px-2 py-0.5 font-mono text-[11px] tracking-[0.06em] text-[var(--sf-ink-3)]">
                        {t}
                      </li>
                    ))}
                  </ul>

                  <div class="mt-5 flex flex-wrap gap-2.5">
                    {project.links.demo && (
                      <a
                        href={project.links.demo}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex min-h-[44px] items-center gap-1.5 rounded-[3px] border border-[var(--sf-accent)] px-4 font-mono text-xs uppercase tracking-[0.14em] text-[var(--sf-accent-ink)] no-underline transition-colors duration-200 hover:bg-[var(--sf-accent)] hover:text-[var(--sf-canvas)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sf-accent)]"
                      >
                        在线访问
                      </a>
                    )}
                    {project.links.github && (
                      <a
                        href={project.links.github}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex min-h-[44px] items-center gap-1.5 rounded-[3px] border border-[var(--sf-line-control)] px-4 font-mono text-xs uppercase tracking-[0.14em] text-[var(--sf-ink-2)] no-underline transition-colors duration-200 hover:border-[var(--sf-accent)] hover:text-[var(--sf-accent-ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sf-accent)]"
                      >
                        GitHub
                      </a>
                    )}
                    {project.links.article && (
                      <a
                        href={project.links.article}
                        class="inline-flex min-h-[44px] items-center gap-1.5 rounded-[3px] border border-[var(--sf-line-control)] px-4 font-mono text-xs uppercase tracking-[0.14em] text-[var(--sf-ink-2)] no-underline transition-colors duration-200 hover:border-[var(--sf-accent)] hover:text-[var(--sf-accent-ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sf-accent)]"
                      >
                        相关文章
                      </a>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </div>
        )}

        {regular.length > 0 && (
          <div>
            <div class="flex items-baseline justify-between gap-4 border-b border-[var(--sf-line)] pb-2">
              <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--sf-ink-3)]">
                Index / 全部项目
              </p>
              <span class="font-mono text-[11px] tabular-nums tracking-[0.1em] text-[var(--sf-ink-3)]">
                {regular.length} 个
              </span>
            </div>

            <div class="mt-4 grid gap-4 sm:grid-cols-2">
              {regular.map((project, index) => (
                <article class="group flex h-full flex-col rounded-[3px] border border-[var(--sf-line)] bg-[var(--sf-surface)] p-5 transition-colors duration-200 hover:border-[var(--sf-line-strong)]">
                  <div class="flex items-center justify-between gap-3">
                    <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--sf-ink-3)]">
                      R{formatOrdinal(index)}
                    </span>
                    <span
                      class={`inline-flex shrink-0 items-center rounded-[3px] border px-2 py-0.5 text-[11px] tracking-[0.08em] ${statusMeta[project.status].className}`}
                    >
                      {statusMeta[project.status].label}
                    </span>
                  </div>

                  <h3 class="mt-2.5 text-lg font-bold tracking-tight text-[var(--sf-ink)]">
                    {project.name}
                  </h3>
                  <p class="mt-1.5 text-xs font-medium text-[var(--sf-ink-2)]">{project.tagline}</p>
                  <p class="mt-2 text-sm leading-6 text-[var(--sf-ink-3)]">{project.description}</p>

                  <ul class="mt-3 flex list-none flex-wrap gap-1.5 p-0" aria-label={`${project.name} 技术栈`}>
                    {project.tech.map((t) => (
                      <li class="rounded-[3px] border border-[var(--sf-line-soft)] px-2 py-0.5 font-mono text-[11px] tracking-[0.06em] text-[var(--sf-ink-3)]">
                        {t}
                      </li>
                    ))}
                  </ul>

                  <div class="mt-auto flex flex-wrap gap-x-4 gap-y-1 pt-4">
                    {project.links.demo && (
                      <a
                        href={project.links.demo}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex min-h-[44px] items-center font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--sf-accent-ink)] no-underline transition-colors duration-200 hover:text-[var(--sf-ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sf-accent)]"
                      >
                        在线访问 →
                      </a>
                    )}
                    {project.links.github && (
                      <a
                        href={project.links.github}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex min-h-[44px] items-center font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--sf-accent-ink)] no-underline transition-colors duration-200 hover:text-[var(--sf-ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sf-accent)]"
                      >
                        GitHub →
                      </a>
                    )}
                    {project.links.article && (
                      <a
                        href={project.links.article}
                        class="inline-flex min-h-[44px] items-center font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--sf-accent-ink)] no-underline transition-colors duration-200 hover:text-[var(--sf-ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sf-accent)]"
                      >
                        相关文章 →
                      </a>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </div>
        )}
      </>
    )}
  </section>
</BaseLayout>
