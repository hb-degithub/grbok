---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../components/layout/PageShell.astro';
import GuestbookBoard from '../components/guestbook/GuestbookBoard';
---

<BaseLayout title="留言板" description="留下你的足迹">
  {/* 展示页统一外壳：PageShell 负责 gutter、页头与唯一 h1，内容列宽保持阅读度量。 */}
  <div class="mx-auto w-full max-w-3xl">
    <PageShell
      eyebrow="Guestbook / 01"
      title="留言板"
      description="随便写点什么，证明你来过。匿名留言，昵称会公开展示。"
    >
      <GuestbookBoard client:visible />
    </PageShell>
  </div>
</BaseLayout>
