---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../components/layout/PageShell.astro';
import SectionHeading from '../components/layout/SectionHeading.astro';
import GalleryBoard from '../components/gallery/GalleryBoard';
---

<BaseLayout title="相册" description="照片与生活的碎片">
  {/* 展示页统一外壳：页头交给 PageShell，照片墙按展示页节奏独立构图。 */}
  <div class="mx-auto w-full max-w-6xl">
    <PageShell
      eyebrow="Gallery / 01"
      title="相册"
      description="照片与生活的碎片，点击查看大图。"
    >
      <SectionHeading
        id="gallery-all-photos"
        eyebrow="All photos / 全部"
        level="h2"
        title="全部照片"
        description="按专辑筛选；灯箱内 ←/→ 切换、Esc 关闭，关闭后焦点回到打开的那张照片。"
      />
      <GalleryBoard client:visible />
    </PageShell>
  </div>
</BaseLayout>
