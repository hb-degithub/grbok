---
import BaseLayout from '../../layouts/BaseLayout.astro';

const errors = [
  ['INVALID_REQUEST', '请检查邮箱地址和请求内容后重试。'],
  ['MAIL_REQUEST_ACCEPTED', '请求已受理；如果账户符合条件，邮件会随后送达。'],
  ['REQUEST_RATE_LIMITED', '请求过于频繁，请等待 Retry-After 指示的时间后重试。'],
  ['EMAIL_RATE_LIMITED', '此邮箱的请求过于频繁，请稍后重试。'],
  ['IP_RATE_LIMITED', '当前网络的请求过于频繁，请稍后重试。'],
  ['GLOBAL_RATE_LIMITED', '邮件服务当前繁忙，请稍后重试。'],
  ['INVALID_REGISTRATION', '请检查注册资料后重新提交。'],
  ['REGISTRATION_RATE_LIMITED', '当前网络的注册请求过于频繁，请稍后重试。'],
  ['REGISTRATION_UNAVAILABLE', '注册保护服务暂不可用，请稍后重试。'],
];
---

<BaseLayout title="邮件与注册错误代码">
  <!-- 不能再用 <main>：BaseLayout 已经提供了页面唯一的 main 地标（审计 P1-2）。 -->
  <div class="mx-auto max-w-3xl px-[var(--sf-pad)] py-16 sm:py-20">
    <header class="mb-10 border-b border-[var(--sf-line)] pb-6">
      <p class="mb-3 flex items-center gap-3 font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--sf-ink-3)]">
        <span class="h-px w-8 bg-[var(--sf-line-strong)]" aria-hidden="true"></span>
        Help / 帮助中心
      </p>
      <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
        <h1 class="text-4xl font-bold tracking-tight text-[var(--sf-ink)] sm:text-5xl">邮件与注册错误代码</h1>
        <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--sf-ink-3)]">共 {errors.length} 个代码</p>
      </div>
      <p class="mt-4 max-w-xl text-[var(--sf-ink-2)]">这些代码只说明可采取的安全操作，不会确认账户是否存在，也不会披露服务商或当前配额信息。</p>
    </header>

    <div class="border-y border-[var(--sf-line)]">
      {errors.map(([code, action], index) => (
        <section id={code} class="scroll-mt-24 border-b border-[var(--sf-line-soft)] py-6 last:border-b-0">
          <p class="mb-1.5 font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--sf-ink-3)]">
            Code / {String(index + 1).padStart(2, '0')}
          </p>
          <h2 class="font-mono text-base font-semibold tracking-[0.02em] text-[var(--sf-ink)] [overflow-wrap:anywhere]">{code}</h2>
          <p class="mt-1.5 text-sm leading-7 text-[var(--sf-ink-2)]">{action}</p>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
