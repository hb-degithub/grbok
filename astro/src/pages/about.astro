---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollReveal from '../components/ui/ScrollReveal';
import Typewriter from '../components/ui/Typewriter';
import GlareHover from '../components/reactbits/GlareHover';
import BlurText from '../components/reactbits/BlurText';
import ParticleField from '../components/effects/ParticleField';
import TechCard from '../components/ui/TechCard';
import FeatureCard from '../components/ui/FeatureCard';

const techStack = [
  {
    name: 'Astro 6',
    desc: 'SSG 静态站点生成，群岛架构',
    detail: '以静态生成为主的元框架，页面默认零 JS 输出，仅在需要的交互"岛屿"中按需水合 React 组件。',
    points: [
      '群岛架构：静态 HTML + 按需水合，首屏 JS 体积最小化',
      'client:visible / client:idle 分级水合策略，非首屏组件延迟加载',
      'MDX 内容管线：文章支持内嵌交互组件与代码高亮',
    ],
  },
  {
    name: 'React 19',
    desc: '交互组件 + Framer Motion 动效',
    detail: '所有客户端交互岛屿由 React 驱动，动效层使用 Framer Motion 声明式编排。',
    points: [
      '评论系统、搜索弹窗、后台面板等交互岛屿',
      'Framer Motion 驱动滚动揭示、页面过渡与微交互',
      'lazy() 拆包：OGL 粒子等重组件按需加载',
    ],
  },
  {
    name: 'TailwindCSS 4',
    desc: '原子化样式，深色主题设计系统',
    detail: '基于 Tailwind 4 的原子化样式体系，配合 CSS 变量实现明暗双主题无缝切换。',
    points: [
      'zinc 中性色 + teal 强调色的统一设计令牌',
      '玻璃态工具类：glass / glass-strong / glass-overlay',
      'Vite 插件零配置集成，构建时 purge 未用样式',
    ],
  },
  {
    name: 'PocketBase',
    desc: 'BaaS 后端 — Auth / DB / API / 文件存储',
    detail: '单文件 Go 后端，内嵌 SQLite，提供认证、数据库、实时订阅与文件存储的完整 BaaS 能力。',
    points: [
      'pb_hooks JS 钩子扩展服务端业务逻辑（限流、邮件、审计）',
      '迁移文件版本化管理数据库结构',
      'Realtime 订阅驱动评论实时更新',
    ],
  },
  {
    name: 'Caddy 2',
    desc: '反向代理，自动 HTTPS，安全响应头',
    detail: '边缘入口网关，统一处理 TLS 终结、安全响应头、静态资源缓存策略与 API 反向代理。',
    points: [
      'CSP / HSTS / X-Frame-Options 等全套安全响应头',
      'HTML 短缓存 + hash 静态资源 immutable 长缓存分级策略',
      '管理路径 IP 白名单与恶意路径拦截',
    ],
  },
  {
    name: 'WebAuthn',
    desc: '管理员 Passkey 双因素认证',
    detail: '管理后台采用 Passkey（WebAuthn）无密码认证，配合独立 admin-auth 服务完成挑战校验。',
    points: [
      '生物识别 / 安全密钥登录，免疫钓鱼与撞库',
      '敏感操作二次验证（step-up auth）',
      '挑战与浏览器会话绑定，事务化签发防重放',
    ],
  },
  {
    name: 'Pagefind',
    desc: '离线全文搜索索引',
    detail: '构建时对静态产物建立全文搜索索引，搜索完全在浏览器端运行，零服务器依赖。',
    points: [
      '构建后自动索引 31 个页面',
      '中文分词支持，结果关键词高亮',
      '索引文件按 hash 长缓存，搜索毫秒级响应',
    ],
  },
  {
    name: 'Docker Compose',
    desc: '容器化编排与部署',
    detail: 'Caddy + PocketBase + admin-auth 三容器编排，一条命令完成全栈部署。',
    points: [
      '容器权限最小化，服务间内网通信',
      '数据卷持久化 SQLite 与上传文件',
      '本地 / 生产双 compose 配置，环境变量注入密钥',
    ],
  },
];

const features = [
  {
    title: '安全加固',
    desc: 'CSP / HSTS / CORS 严格策略，多层速率限制，DOMPurify 防注入，Docker 容器权限最小化',
    detail: '从边缘到容器逐层设防，覆盖注入、XSS、暴力破解与滥用四大攻击面。',
    points: [
      'CSP 白名单精确到源，script-src 收紧至 self + inline 岛屿',
      '评论 / 登录 / 邮件多层速率限制，桶过期自动清理',
      'UGC 内容 DOMPurify 服务端 + 客户端双重净化',
    ],
  },
  {
    title: '管理员体系',
    desc: 'RBAC 四级角色，WebAuthn Passkey 二次验证，服务端认证守卫，IP 白名单',
    detail: '管理后台独立认证服务，敏感操作强制二次验证，从身份到网络多层收窄入口。',
    points: [
      '四级角色：读者 / 作者 / 管理员 / 超级管理员',
      '删号、改密等敏感操作需 Passkey step-up 验证',
      'Caddy 层管理路径 IP 白名单，未授权直接 403',
    ],
  },
  {
    title: '交互体验',
    desc: '粒子背景、网格扫描、Dock 导航、Bento 卡片、阅读进度、滚动揭示动效',
    detail: '全站动效系统以"克制的华丽"为原则，视觉丰富但不牺牲性能。',
    points: [
      'OGL 粒子与网格扫描按需懒加载，非首屏延迟水合',
      'macOS 风格 Dock 导航，客户端路由同步激活态',
      '阅读进度条 + 滚动揭示，长文阅读节奏引导',
    ],
  },
  {
    title: 'SEO & PWA',
    desc: 'RSS 订阅、站点地图、Open Graph、Service Worker 离线缓存、Manifest',
    detail: '完整的 SEO 元信息体系与 PWA 离线能力，可安装到主屏当 App 用。',
    points: [
      '文章页 Open Graph / Twitter Card 自动注入',
      'SW 版本号构建时注入，部署后缓存自动失效',
      '离线兜底页 + 静态资源预缓存',
    ],
  },
  {
    title: '评论系统',
    desc: '嵌套回复、服务端校验、邮件通知、速率限制、实时订阅更新',
    detail: '自建评论体系，数据完全自有，支持嵌套对话与实时更新。',
    points: [
      'PocketBase Realtime 订阅，新评论即时出现',
      '发表评论触发邮件通知（限流防轰炸）',
      '订阅竞态防护，页面导航后残留监听自动清理',
    ],
  },
  {
    title: '全文搜索',
    desc: 'Pagefind 离线索引，即时搜索结果高亮，零服务器依赖',
    detail: '搜索完全运行在浏览器端，无需后端查询，离线也能用。',
    points: [
      '玻璃态搜索弹窗，骨架屏加载与空状态引导',
      '键盘导航：↑↓ 选择、Enter 跳转、Esc 关闭',
      '中文内容索引，关键词上下文高亮',
    ],
  },
];

const links = [
  { name: 'GitHub', url: 'https://github.com', icon: 'M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z' },
  { name: 'B站', url: 'https://space.bilibili.com/691237475', icon: 'M17.813 4.653h.854c1.51.054 2.769.578 3.773 1.574 1.004.995 1.524 2.249 1.56 3.76v7.36c-.036 1.51-.556 2.769-1.56 3.773s-2.262 1.524-3.773 1.56H5.333c-1.51-.036-2.769-.556-3.773-1.56S.036 18.858 0 17.347v-7.36c.036-1.511.556-2.765 1.56-3.76 1.004-.996 2.262-1.52 3.773-1.574h.774l-1.174-1.12a1.234 1.234 0 0 1-.373-.906c0-.356.124-.659.373-.907l.027-.027c.267-.249.573-.373.92-.373.347 0 .653.124.92.373L9.653 4.44c.071.071.134.142.187.213h4.267a.836.836 0 0 1 .16-.213l2.853-2.747c.267-.249.573-.373.92-.373.347 0 .662.151.929.4.267.249.391.551.391.907 0 .355-.124.657-.373.906zM5.333 7.24c-.746.018-1.373.276-1.88.773-.506.498-.769 1.13-.786 1.894v7.52c.017.764.28 1.395.786 1.893.507.498 1.134.756 1.88.773h13.334c.746-.017 1.373-.275 1.88-.773.506-.498.769-1.129.786-1.893v-7.52c-.017-.765-.28-1.396-.786-1.894-.507-.497-1.134-.755-1.88-.773zM8 11.107c.373 0 .684.124.933.373.25.249.383.569.4.96v1.173c-.017.391-.15.711-.4.96-.249.25-.56.374-.933.374s-.684-.125-.933-.374c-.25-.249-.383-.569-.4-.96V12.44c0-.373.129-.689.386-.947.258-.257.574-.386.947-.386zm8 0c.373 0 .684.124.933.373.25.249.383.569.4.96v1.173c-.017.391-.15.711-.4.96-.249.25-.56.374-.933.374s-.684-.125-.933-.374c-.25-.249-.383-.569-.4-.96V12.44c.017-.391.15-.711.4-.96.249-.249.56-.373.933-.373z' },
  { name: 'Email', url: 'mailto:670486183@qq.com', icon: 'M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2zm16 2l-8 5-8-5v2l8 5 8-5V6zm0 12H4V8l8 5 8-5v10z' },
];
---

<BaseLayout title="关于" description="关于这个博客和作者">
  <div class="pointer-events-none fixed inset-0 z-0 hidden lg:block" aria-hidden="true">
    <ParticleField client:visible count={36} speed={0.25} />
  </div>
  <div class="relative z-10 max-w-3xl mx-auto">
    <!-- 头部 -->
    <ScrollReveal client:visible>
      <div class="mb-16 text-center">
        <div class="mb-6 inline-flex h-24 w-24 items-center justify-center rounded-full border-2 border-zinc-200 bg-zinc-100 dark:border-zinc-700 dark:bg-zinc-800">
          <span class="font-display text-3xl font-black text-zinc-500 dark:text-zinc-400">B</span>
        </div>
        <h1 class="font-display text-4xl font-black uppercase tracking-wide text-zinc-900 dark:text-zinc-100 mb-4">
          <BlurText client:visible text="关于博客" className="text-4xl font-black tracking-tight text-zinc-950 dark:text-zinc-50 sm:text-5xl" />
        </h1>
        <div class="text-zinc-500 dark:text-zinc-400">
          <Typewriter
            text="分享技术、思考与生活"
            client:visible
          />
        </div>
      </div>
    </ScrollReveal>

    <!-- 介绍 -->
    <ScrollReveal delay={0.1} client:visible>
      <div class="card rounded-lg p-8 mb-8">
        <h2 class="font-display text-xl font-bold uppercase tracking-wide text-zinc-900 dark:text-zinc-100 mb-4">
          关于这个博客
        </h2>
        <div class="space-y-4 text-zinc-500 dark:text-zinc-400">
          <p>
            胡巴的博客是一个自建的全栈个人博客系统，使用 Astro + React + PocketBase 构建，自 2025 年运行至今。
          </p>
          <p>
            前端采用 Astro 群岛架构实现静态生成与交互组件的混合渲染，后端依托 PocketBase 提供 Auth、数据库与 API 服务，Caddy 负责反向代理与安全防护，Docker Compose 统一编排部署。
          </p>
        </div>
      </div>
    </ScrollReveal>

    <!-- 技术栈 -->
    <ScrollReveal delay={0.2} client:visible>
      <div class="card rounded-lg p-8 mb-8">
        <h2 class="font-display text-xl font-bold uppercase tracking-wide text-zinc-900 dark:text-zinc-100 mb-6">
          技术栈
        </h2>
        <p class="mb-4 text-xs text-zinc-400 dark:text-zinc-500">
          <span class="hidden [@media(hover:hover)]:inline">鼠标悬停查看技术细节</span>
          <span class="[@media(hover:hover)]:hidden">点击卡片查看技术细节</span>
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {techStack.map((tech) => (
            <GlareHover client:visible glareColor="rgba(20, 184, 166, 0.08)">
              <TechCard client:visible tech={tech} />
            </GlareHover>
          ))}
        </div>
      </div>
    </ScrollReveal>

    <!-- 功能特性 -->
    <ScrollReveal delay={0.25} client:visible>
      <div class="card rounded-lg p-8 mb-8">
        <h2 class="font-display text-xl font-bold uppercase tracking-wide text-zinc-900 dark:text-zinc-100 mb-6">
          功能特性
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {features.map((f) => (
            <FeatureCard client:visible feature={f} />
          ))}
        </div>
      </div>
    </ScrollReveal>

    <!-- 联系方式 -->
    <ScrollReveal delay={0.3} client:visible>
      <div class="card rounded-lg p-8">
        <h2 class="font-display text-xl font-bold uppercase tracking-wide text-zinc-900 dark:text-zinc-100 mb-6">
          联系方式
        </h2>
        <div class="flex flex-wrap gap-4">
          {links.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-ghost flex items-center gap-2"
            >
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                <path d={link.icon} />
              </svg>
              {link.name}
            </a>
          ))}
        </div>
      </div>
    </ScrollReveal>
  </div>
</BaseLayout>
