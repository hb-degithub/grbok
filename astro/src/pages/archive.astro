---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageShell from "../components/layout/PageShell.astro";
import SectionHeading from "../components/layout/SectionHeading.astro";
import { cachedFetchJson } from '../lib/pb-cache';
import { pbBaseUrl } from '../lib/pb-base-url';
// SSR 取数走服务端回环地址，浏览器侧仍用公网域名（见 pb-base-url.ts）
const PB_URL = pbBaseUrl();
interface ArchivePost {
  id: string;
  title: string;
  slug: string;
  published_at: string;
}
interface ArchiveGroup {
  year: number;
  months: { month: number; posts: ArchivePost[] }[];
}
let posts: ArchivePost[] = [];
try {
  // perPage=500：缺省 perPage 只返回前 30 条，会漏掉更早的文章
  const url = PB_URL + "/api/collections/posts/records?sort=-published_at" + "&filter=" + encodeURIComponent('status="published"') + "&fields=id,title,slug,published_at&perPage=500";
  const data = await cachedFetchJson<{ items?: ArchivePost[] }>(url, { signal: AbortSignal.timeout(3000) }, 60_000);
  posts = data.items ?? [];
} catch {}
const groups: ArchiveGroup[] = [];
for (const post of posts) {
  const d = new Date(post.published_at);
  const y = d.getFullYear(); const m = d.getMonth() + 1;
  let yg = groups.find(g => g.year === y);
  if (!yg) { yg = { year: y, months: [] }; groups.push(yg); }
  let mg = yg.months.find(x => x.month === m);
  if (!mg) { mg = { month: m, posts: [] }; yg.months.push(mg); }
  mg.posts.push(post);
}
---

<BaseLayout title="文章归档" description="按时间归档">
  {/* 页头与时间轴共用同一个阅读列宽：PageShell 负责页头与 gutter，外层只收敛行宽。 */}
  <div class="mx-auto w-full max-w-3xl">
    <PageShell
      eyebrow="Archive / 01"
      title="文章归档"
      description={`共 ${posts.length} 篇已发布文章，按年份与月份分组。`}
    >
      {groups.length === 0 ? (
        <div class="border-y border-[var(--sf-line)] px-1 py-16 text-center">
          <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--sf-ink-3)]">Empty / 0</p>
          <p class="mt-3 text-[var(--sf-ink-2)]">暂无归档文章</p>
        </div>
      ) : (
        groups.map((yearGroup) => (
          <section aria-labelledby={`archive-year-${yearGroup.year}`}>
            <SectionHeading id={`archive-year-${yearGroup.year}`} level="h2" title={String(yearGroup.year)}>
              <span
                slot="action"
                class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--sf-ink-3)]"
              >
                {yearGroup.months.length} 个月
              </span>
            </SectionHeading>

            {yearGroup.months.map((monthGroup) => (
              <div class="archive-month mt-5">
                <h3 class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--sf-ink-3)]">
                  {monthGroup.month} 月
                </h3>
                <ul class="mt-2 list-none p-0">
                  {monthGroup.posts.map((post) => (
                    <li>
                      <a
                        href={"/posts/" + post.slug}
                        class="archive-entry group flex items-baseline gap-4 py-1.5 text-sm no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sf-accent)]"
                      >
                        <time
                          datetime={post.published_at}
                          class="shrink-0 font-mono text-[11px] tabular-nums tracking-[0.08em] text-[var(--sf-ink-3)]"
                        >
                          {new Date(post.published_at).toLocaleDateString("zh-CN", { month: "2-digit", day: "2-digit" })}
                        </time>
                        <span class="min-w-0 flex-1 text-[var(--sf-ink-2)] transition-colors duration-200 [overflow-wrap:anywhere] group-hover:text-[var(--sf-accent-ink)]">
                          {post.title}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </section>
        ))
      )}
    </PageShell>
  </div>

  <style>
    /* 归档时间轴：冷灰细线 + 小色点，hover 才用强调色 */
    .archive-month {
      position: relative;
      border-left: 1px solid var(--sf-line);
      padding-left: 1.25rem;
    }

    .archive-entry {
      position: relative;
    }

    .archive-entry::before {
      content: "";
      position: absolute;
      left: calc(-1.25rem - 3px);
      top: 50%;
      width: 5px;
      height: 5px;
      margin-top: -2.5px;
      border-radius: 9999px;
      background: var(--sf-line-strong);
      transition: background 0.2s ease, transform 0.2s ease;
    }

    .archive-entry:hover::before,
    .archive-entry:focus-visible::before {
      background: var(--sf-accent);
      transform: scale(1.6);
    }

    @media (prefers-reduced-motion: reduce) {
      .archive-entry::before {
        transition: none;
      }
    }
  </style>
</BaseLayout>
