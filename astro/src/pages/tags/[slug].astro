---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageShell from '../../components/layout/PageShell.astro';
import SectionHeading from '../../components/layout/SectionHeading.astro';
import PostList from '../../components/posts/PostList';
import { cachedFetchJson } from '../../lib/pb-cache';
import { pbBaseUrl } from '../../lib/pb-base-url';

// SSR模式：禁用预渲染，每次请求时动态生成
export const prerender = false;

// SSR 取数走服务端回环地址，浏览器侧仍用公网域名（见 pb-base-url.ts）
const PB_URL = pbBaseUrl();

const { slug } = Astro.params;

interface Tag {
  id: string;
  name: string;
  slug: string;
  description: string;
}

async function fetchTag(tagSlug: string): Promise<Tag | null> {
  try {
    const data = await cachedFetchJson<{ items?: Tag[] }>(
      `${PB_URL}/api/collections/tags/records?filter=${encodeURIComponent('slug="' + tagSlug.replace(/["\\]/g, '') + '"')}`,
      { signal: AbortSignal.timeout(3000) },
      60_000,
    );
    return data.items?.[0] ?? null;
  } catch {
    return null;
  }
}

const tag = await fetchTag(slug ?? '');

// 标签不存在时返回真正的 404（此前是 200 + 「标签不存在」文案，属软 404，
// 既会被搜索引擎收录，也让调用方无法区分「没有这个标签」和「标签下没有文章」）。
if (!tag) {
  Astro.response.status = 404;
}

// 页码状态放在 URL 上（?page=N）：SSR 首屏与岛内翻页共用同一个来源。
const requestedPage = Number.parseInt(Astro.url.searchParams.get('page') ?? '', 10);
const initialPage = Number.isFinite(requestedPage) && requestedPage > 0 ? requestedPage : 1;
---

<BaseLayout
  title={tag ? `标签: ${tag.name}` : '标签不存在'}
  description={tag?.description || '按标签筛选文章'}
>
  {/* 页头与列表共用同一个阅读列宽：PageShell 负责页头与 gutter，外层只收敛行宽。 */}
  <div class="mx-auto w-full max-w-4xl">
    <PageShell
      eyebrow="Taxonomy / Tag"
      title={tag ? tag.name : '标签不存在'}
      description={tag
        ? tag.description || '按发布时间倒序浏览该标签下的文章。'
        : '该标签不存在或已被删除，请回到标签列表重新选择。'}
    >
      {tag ? (
        <>
          <SectionHeading
            id="tag-posts-title"
            eyebrow="Posts"
            level="h2"
            title="该标签下的文章"
            description="每页 12 篇；页码保存在 ?page= 中。"
          />

          <PostList client:visible perPage={12} tagSlug={slug} initialPage={initialPage} syncPageQuery />
        </>
      ) : (
        <div class="border-y border-[var(--sf-line)] px-1 py-16 text-center">
          <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--sf-ink-3)]">Error / 404</p>
          <p class="mt-3 text-[var(--sf-ink-2)]">标签不存在</p>
          <p class="mt-2 text-sm text-[var(--sf-ink-3)]">该标签可能已被删除，或链接拼写有误。</p>
          <a href="/tags" class="orbital-action mt-5 inline-flex">返回标签列表</a>
        </div>
      )}
    </PageShell>
  </div>
</BaseLayout>
