---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/posts/PostList';
import { cachedFetchJson } from '../../lib/pb-cache';
import { pbBaseUrl } from '../../lib/pb-base-url';

// SSR模式：禁用预渲染，每次请求时动态生成
export const prerender = false;

// SSR 取数走服务端回环地址，浏览器侧仍用公网域名（见 pb-base-url.ts）
const PB_URL = pbBaseUrl();

const { slug } = Astro.params;

interface Tag {
  id: string;
  name: string;
  slug: string;
  description: string;
}

async function fetchTag(tagSlug: string): Promise<Tag | null> {
  try {
    const data = await cachedFetchJson<{ items?: Tag[] }>(
      `${PB_URL}/api/collections/tags/records?filter=${encodeURIComponent('slug="' + tagSlug.replace(/["\\]/g, '') + '"')}`,
      { signal: AbortSignal.timeout(3000) },
      60_000,
    );
    return data.items?.[0] ?? null;
  } catch {
    return null;
  }
}

const tag = await fetchTag(slug ?? '');
---

<BaseLayout title={tag ? `标签: ${tag.name}` : '标签'} description={tag?.description || '按标签筛选文章'}>
  <section class="mx-auto w-full max-w-5xl px-5 py-16 sm:px-8 lg:px-10">
    <header class="mb-10 border-b border-[var(--sf-line)] pb-6">
      <p class="mb-3 flex items-center gap-3 font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--sf-ink-3)]">
        <span class="h-px w-8 bg-[var(--sf-line-strong)]" aria-hidden="true"></span>
        Taxonomy / Tag
      </p>
      <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
        <h1 class="text-4xl font-bold tracking-tight text-[var(--sf-ink)] sm:text-5xl">
          {tag ? tag.name : '标签'}
        </h1>
        <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--sf-ink-3)]">标签归档</p>
      </div>
      {tag?.description && (
        <p class="mt-3 max-w-xl text-[var(--sf-ink-2)]">
          {tag.description}
        </p>
      )}
    </header>

    {tag ? (
      <PostList client:visible perPage={12} tagSlug={slug} />
    ) : (
      <div class="border-y border-[var(--sf-line)] px-1 py-16 text-center">
        <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--sf-ink-3)]">Empty / 0</p>
        <p class="mt-3 text-[var(--sf-ink-2)]">暂无标签</p>
        <p class="mt-2 text-sm text-[var(--sf-ink-3)]">标签不存在</p>
        <a
          href="/tags"
          class="mt-5 inline-flex min-h-[44px] items-center rounded-[3px] border border-[var(--sf-line-control)] px-4 font-mono text-xs uppercase tracking-[0.14em] text-[var(--sf-ink-2)] no-underline transition-colors duration-200 hover:border-[var(--sf-accent)] hover:text-[var(--sf-accent-ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sf-accent)]"
        >
          返回标签列表
        </a>
      </div>
    )}
  </section>
</BaseLayout>
