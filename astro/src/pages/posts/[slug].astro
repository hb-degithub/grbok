---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ScrollReveal from '../../components/ui/ScrollReveal';
import ShareButton from '../../components/ui/ShareButton';
import CommentSection from '../../components/comments/CommentSection';
import TableOfContents from '../../components/posts/TableOfContents';
import { sanitizeHtml } from '../../lib/security';

const PB_URL = import.meta.env.PUBLIC_POCKETBASE_URL || 'http://localhost:8090';

export async function getStaticPaths() {
  try {
    const pbUrl = import.meta.env.PUBLIC_POCKETBASE_URL || 'http://localhost:8090';
    const filter = encodeURIComponent('status="published"');
    const res = await fetch(`${pbUrl}/api/collections/posts/records?filter=${filter}&fields=slug&perPage=200`);
    if (!res.ok) return [];
    const data = await res.json();
    return (data.items || [])
      .filter((post: { slug?: string }) => post.slug)
      .map((post: { slug: string }) => ({ params: { slug: post.slug } }));
  } catch {
    return [];
  }
}

const { slug } = Astro.params;

interface Post {
  id: string;
  title: string;
  slug: string;
  content: string;
  excerpt: string;
  cover: string;
  status: string;
  published_at: string;
  views: number;
  expand?: {
    author?: {
      name: string;
    };
  };
}

async function fetchPost(postSlug: string): Promise<Post | null> {
  try {
    const safeSlug = postSlug.replace(/["\\]/g, '');
    const filter = `slug="${safeSlug}" && status="published"`;
    const res = await fetch(`${PB_URL}/api/collections/posts/records?filter=${encodeURIComponent(filter)}&expand=author`);
    if (!res.ok) throw new Error(`${res.status}`);
    const data = await res.json();
    return data.items?.[0] ?? null;
  } catch {
    return null;
  }
}

const post = await fetchPost(slug ?? '');

const formattedDate = post?.published_at
  ? new Date(post.published_at).toLocaleDateString('zh-CN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : '';

const readingTime = post?.content ? Math.max(1, Math.ceil(post.content.length / 300)) : 0;
let safeContent = post?.content ? sanitizeHtml(post.content) : '';

// Extract headings and inject IDs for TOC
interface Heading { id: string; text: string; level: number; }
const headings: Heading[] = [];
let headingIndex = 0;
safeContent = safeContent.replace(/<(h[23])>(.*?)<\/\1>/gi, (_, tag, text) => {
  const level = parseInt(tag[1], 10);
  const id = `heading-${headingIndex++}`;
  const plainText = text.replace(/<[^>]+>/g, '');
  headings.push({ id, text: plainText, level });
  return `<${tag} id="${id}">${text}</${tag}>`;
});
---

<BaseLayout title={post?.title || '文章'} description={post?.excerpt || ''} image={post?.cover}>
  {post ? (
    <article class="mx-auto w-full max-w-5xl px-[var(--page-pad,1rem)] py-8 sm:py-10">
      <!-- Mobile TOC -->
      {headings.length > 0 && (
        <div class="mb-6 lg:hidden">
          <TableOfContents client:load headings={headings} />
        </div>
      )}

      <div class="flex gap-8">
        <div class="flex-1 min-w-0">
          <ScrollReveal client:visible>
        <a href="/posts" class="mb-8 inline-flex min-h-11 items-center gap-2 rounded-lg text-zinc-500 transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          返回文章列表
        </a>
      </ScrollReveal>

      <ScrollReveal delay={0.1} client:visible>
        <header class="mb-12">
          <div class="mb-4 flex min-w-0 items-center gap-3">
            <span class="h-px w-8 bg-zinc-400 dark:bg-zinc-500"></span>
            <span class="font-mono text-[10px] uppercase tracking-widest text-zinc-500 dark:text-zinc-400">Article</span>
          </div>

          <h1 class="mb-6 break-words text-3xl font-black leading-tight tracking-normal text-zinc-900 [overflow-wrap:anywhere] dark:text-zinc-100 sm:text-4xl md:text-5xl">
            {post.title}
          </h1>

          <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-zinc-500 dark:text-zinc-400">
            {post.expand?.author && (
              <span class="flex items-center gap-2">
                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-zinc-200 text-xs font-semibold text-zinc-600 dark:bg-zinc-700 dark:text-zinc-300">
                  {post.expand.author.name.charAt(0)}
                </span>
                {post.expand.author.name}
              </span>
            )}
            {formattedDate && <time datetime={post.published_at}>{formattedDate}</time>}
            <span>{readingTime} 分钟阅读</span>
            <span>{post.views} 次浏览</span>
          </div>

          {post.cover && (
            <div class="mt-8 overflow-hidden rounded-xl border border-zinc-200 shadow-xl shadow-zinc-900/[0.04] dark:border-zinc-800">
              <img src={post.cover} alt={post.title} class="h-auto w-full object-cover opacity-0 transition-opacity duration-500" loading="lazy" onload="this.style.opacity='1'" />
            </div>
          )}
        </header>
      </ScrollReveal>

      <div class="prose mb-16 max-w-full break-words [overflow-wrap:anywhere] reveal-content">
        <div set:html={safeContent} />
      </div>

      <ScrollReveal delay={0.3} client:visible>
        <footer class="border-t border-zinc-200 pt-10 dark:border-zinc-800">
          <div class="flex flex-col gap-6">
            <CommentSection postId={post.id} client:visible />
            <div class="flex justify-center">
              <ShareButton client:visible />
            </div>
            <nav class="grid gap-4 sm:grid-cols-2" aria-label="文章导航">
              <a href="/posts" class="flex items-center gap-2 rounded-lg border border-zinc-200 p-4 text-sm text-zinc-600 transition-colors hover:border-zinc-300 hover:text-zinc-900 dark:border-zinc-800 dark:text-zinc-400 dark:hover:border-zinc-700 dark:hover:text-zinc-200">
                <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                <span class="truncate">返回文章列表</span>
              </a>
              <a href="/" class="flex items-center justify-end gap-2 rounded-lg border border-zinc-200 p-4 text-sm text-zinc-600 transition-colors hover:border-zinc-300 hover:text-zinc-900 dark:border-zinc-800 dark:text-zinc-400 dark:hover:border-zinc-700 dark:hover:text-zinc-200">
                <span class="truncate">返回首页</span>
                <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </nav>
          </div>
        </footer>
      </ScrollReveal>
        </div>

        <!-- Desktop TOC sidebar -->
        {headings.length > 0 && (
          <aside class="hidden lg:block w-52 shrink-0 sticky top-[calc(var(--header-offset,4rem)+2rem)] self-start max-h-[calc(100vh-8rem)]">
            <TableOfContents client:load headings={headings} />
          </aside>
        )}
      </div>
    </article>
  ) : (
    <div class="flex flex-col items-center justify-center px-4 py-20 text-center">
      <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-lg border border-zinc-200 bg-zinc-100 dark:border-zinc-700 dark:bg-zinc-800">
        <svg class="h-8 w-8 text-zinc-400 dark:text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <h2 class="mb-2 text-2xl font-bold text-zinc-900 dark:text-zinc-100">文章不存在</h2>
      <p class="mb-6 text-zinc-500 dark:text-zinc-400">请先在 PocketBase 中创建文章。</p>
      <a href="/posts" class="btn-primary">返回文章列表</a>
    </div>
  )}
</BaseLayout>

<style>
  .reveal-content > div > * {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .reveal-content > div > *.revealed {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal-content > div > * {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const prose = document.querySelector('.reveal-content > div');
  if (prose) {
    const children = Array.from(prose.children);
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const idx = children.indexOf(el);
          el.style.transitionDelay = `${Math.min(idx * 40, 400)}ms`;
          el.classList.add('revealed');
          observer.unobserve(el);
        }
      }
    }, { rootMargin: '0px 0px -40px 0px', threshold: 0.1 });
    children.forEach(child => observer.observe(child));
  }
</script>
