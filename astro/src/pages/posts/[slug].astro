---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ScrollReveal from '../../components/ui/ScrollReveal';
import ShareButton from '../../components/ui/ShareButton';
import CommentSection from '../../components/comments/CommentSection';
import TableOfContents from '../../components/posts/TableOfContents';
import PostActions from '../../components/posts/PostActions';
import MermaidRenderer from '../../components/posts/MermaidRenderer';
import ReadingProgress from '../../components/effects/ReadingProgress';
import { renderMarkdown, stripDuplicateTitleHeading } from '../../lib/markdown';
import { cachedFetchJson } from '../../lib/pb-cache';
import { pbBaseUrl } from '../../lib/pb-base-url';
// KaTeX 的官方样式（字体、分数线、上下标定位）只在文章页加载，其它页面不受影响。
import 'katex/dist/katex.min.css';

// SSR模式：禁用预渲染，每次请求时动态生成
export const prerender = false;

// SSR 取数走服务端回环地址，浏览器侧仍用公网域名（见 pb-base-url.ts）
const PB_URL = pbBaseUrl();

const { slug } = Astro.params;

interface Post {
  id: string;
  title: string;
  slug: string;
  content: string;
  excerpt: string;
  cover: string;
  status: string;
  published_at: string;
  views: number;
  likes?: number;
  expand?: {
    author?: {
      name: string;
      avatar?: string;
    };
  };
}

async function fetchPost(postSlug: string): Promise<Post | null> {
  try {
    const safeSlug = postSlug.replace(/["\\]/g, '');
    const filter = `slug="${safeSlug}" && status="published"`;
    const data = await cachedFetchJson<{ items?: Post[] }>(
      `${PB_URL}/api/collections/posts/records?filter=${encodeURIComponent(filter)}&expand=author`,
      { signal: AbortSignal.timeout(3000) },
    );
    return data.items?.[0] ?? null;
  } catch {
    return null;
  }
}

const post = await fetchPost(slug ?? '');
// 文章不存在时返回真正的 404（此前 SSR 渲染 404 文案但状态码是 200，软 404 会被搜索引擎收录）。
if (!post) {
  Astro.response.status = 404;
  // 状态码之外补上标准状态文本，避免响应出现 "404 OK" 这类自相矛盾的措辞。
  Astro.response.statusText = 'Not Found';
}

// 2026-11-16：users 的 viewRule 只允许本人/管理员读，匿名 expand=author 恒为空
// （实测 items[0].expand === null），文章页因此一直不显示作者。这里在 expand 缺失时
// 回退到只返回 name/avatar 的公开接口，避免为了展示作者而放开整张 users 表。
if (post && !post.expand?.author && typeof (post as { author?: string }).author === 'string' && (post as { author?: string }).author) {
  try {
    const authorId = encodeURIComponent(String((post as { author?: string }).author).replace(/["\\]/g, ''));
    const author = await cachedFetchJson<{ name?: string; avatar?: string }>(
      `${PB_URL}/api/public/authors/${authorId}`,
      { signal: AbortSignal.timeout(3000) },
      60_000,
    );
    if (author && author.name) {
      post.expand = { author: { name: author.name, avatar: author.avatar || '' } };
    }
  } catch {
    // 作者信息只是装饰，取不到不影响正文
  }
}

const formattedDate = post?.published_at
  ? new Date(post.published_at).toLocaleDateString('zh-CN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : '';

const readingTime = post?.content ? Math.max(1, Math.ceil(post.content.length / 300)) : 0;
// posts.content 是 Markdown；renderMarkdown 内部完成 GFM 解析、代码高亮、
// KaTeX 公式、mermaid 源码容器与净化（详见 src/lib/markdown.ts）。
let safeContent = post?.content ? renderMarkdown(post.content) : '';

// 文章正文常以 `# 标题` 开头（渲染器已把 h1 降级为 h2），与页面 h1 重复时删掉这一处。
if (post?.title && safeContent) {
  safeContent = stripDuplicateTitleHeading(safeContent, post.title);
}

// 只有正文真的包含 mermaid 图时才挂载客户端岛屿，避免无关文章下载 mermaid。
const hasMermaid = safeContent.includes('class="mermaid"');

// Extract headings and inject IDs for TOC
interface Heading { id: string; text: string; level: number; }
const headings: Heading[] = [];
let headingIndex = 0;
safeContent = safeContent.replace(/<(h[23])>(.*?)<\/\1>/gi, (_, tag, text) => {
  const level = parseInt(tag[1], 10);
  const id = `heading-${headingIndex++}`;
  const plainText = text.replace(/<[^>]+>/g, '');
  headings.push({ id, text: plainText, level });
  return `<${tag} id="${id}">${text}</${tag}>`;
});
---

<BaseLayout title={post?.title || '文章不存在'} description={post?.excerpt || ''} image={post?.cover}>
  {post ? (
    <>
    <ReadingProgress client:visible />
    <article class="mx-auto w-full max-w-6xl px-[var(--sf-pad)] py-10 sm:py-14">
      <div class="lg:flex lg:items-start lg:justify-center lg:gap-12">
        <div class="min-w-0 mx-auto w-full max-w-[42rem] lg:mx-0 lg:max-w-[42rem]">
          <ScrollReveal client:visible>
        <a href="/posts" class="mb-8 inline-flex min-h-11 items-center gap-2 font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--sf-ink-3)] no-underline transition-colors duration-200 hover:text-[var(--sf-accent-ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sf-accent)]">
          <span aria-hidden="true">←</span>
          返回文章列表
        </a>
      </ScrollReveal>

      <ScrollReveal delay={0.1} client:visible>
        <header class="post-hero mb-8 border-b border-[var(--sf-line)] pb-8">
          <p class="mb-4 flex items-center gap-3 font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--sf-ink-3)]">
            <span class="h-px w-8 bg-[var(--sf-line-strong)]" aria-hidden="true"></span>
            Article / 01
          </p>

          <h1 class="post-title mb-5 text-balance break-words text-[clamp(1.85rem,4.6vw,3rem)] font-bold leading-[1.14] tracking-[-0.025em] text-[var(--sf-ink)] [overflow-wrap:anywhere]">
            {post.title}
          </h1>

          {post.excerpt && (
            <p class="mb-6 max-w-[38rem] text-base leading-relaxed text-[var(--sf-ink-2)] sm:text-lg">
              {post.excerpt}
            </p>
          )}

          <div class="flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-[11px] tracking-[0.06em] text-[var(--sf-ink-3)]">
            {post.expand?.author && (
              <span class="flex items-center gap-2">
                <span class="flex h-6 w-6 items-center justify-center border border-[var(--sf-line)] text-[10px] text-[var(--sf-ink-2)]" aria-hidden="true">
                  {post.expand.author.name.charAt(0)}
                </span>
                <span class="text-[var(--sf-ink-2)]">{post.expand.author.name}</span>
              </span>
            )}
            {formattedDate && <time datetime={post.published_at}>{formattedDate}</time>}
            <span aria-hidden="true" class="hidden text-[var(--sf-line-strong)] sm:inline">/</span>
            <span>{readingTime} 分钟阅读</span>
            <span aria-hidden="true" class="hidden text-[var(--sf-line-strong)] sm:inline">/</span>
            <span>{post.views} 次浏览</span>
          </div>

          {post.cover && (
            <div class="post-cover mt-7 border border-[var(--sf-line)] bg-[var(--sf-surface)] p-1">
              <img src={post.cover} alt={post.title} class="h-auto w-full object-cover" loading="lazy" decoding="async" />
            </div>
          )}
        </header>
      </ScrollReveal>

      {/* 移动端目录放在标题之后：先给读者标题，再给跳转工具 */}
      {headings.length > 0 && (
        <div class="mb-8 lg:hidden">
          <TableOfContents client:idle headings={headings} />
        </div>
      )}

      <p class="mb-4 flex items-center gap-3 font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--sf-ink-3)]">
        <span class="h-px w-8 bg-[var(--sf-line-strong)]" aria-hidden="true"></span>
        Body / 02
      </p>

      <div class="prose reveal-content mb-10 max-w-full break-words text-[var(--sf-ink-2)] [overflow-wrap:anywhere]">
        <div set:html={safeContent} />
      </div>

      {hasMermaid && <MermaidRenderer client:idle />}

      <div class="mb-10 border-y border-[var(--sf-line)] py-4">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--sf-ink-3)]">React / 03</p>
          <PostActions postId={post.id} initialLikes={post.likes ?? 0} client:visible />
        </div>
      </div>

      <ScrollReveal delay={0.3} client:visible>
        <footer>
          <div class="mb-10 border-t border-[var(--sf-line)] pt-8">
            <p class="mb-6 font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--sf-ink-3)]">Comments / 04</p>
            <CommentSection postId={post.id} client:visible />
          </div>
          <div class="flex flex-wrap items-center justify-between gap-4 border-t border-[var(--sf-line)] py-6">
            <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--sf-ink-3)]">Share / 05</p>
            <ShareButton client:visible />
          </div>
          <nav class="grid gap-3 border-t border-[var(--sf-line)] pt-6 sm:grid-cols-2" aria-label="文章导航">
            <a href="/posts" class="inline-flex min-h-11 items-center gap-2 border border-[var(--sf-line)] px-4 text-sm text-[var(--sf-ink-2)] no-underline transition-colors duration-200 hover:border-[var(--sf-line-control)] hover:text-[var(--sf-ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sf-accent)]">
              <span aria-hidden="true" class="text-[var(--sf-line-control)]">←</span>
              <span class="truncate">返回文章列表</span>
            </a>
            <a href="/" class="inline-flex min-h-11 items-center justify-start gap-2 border border-[var(--sf-line)] px-4 text-sm text-[var(--sf-ink-2)] no-underline transition-colors duration-200 hover:border-[var(--sf-line-control)] hover:text-[var(--sf-ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sf-accent)] sm:justify-end">
              <span class="truncate">返回首页</span>
              <span aria-hidden="true" class="text-[var(--sf-line-control)]">→</span>
            </a>
          </nav>
        </footer>
      </ScrollReveal>
        </div>

        {/* Desktop TOC sidebar */}
        {headings.length > 0 && (
          <aside class="hidden w-56 shrink-0 self-start overflow-y-auto lg:sticky lg:top-[calc(var(--header-offset,4rem)+2rem)] lg:block lg:max-h-[calc(100vh-8rem)]">
            <p class="mb-3 border-b border-[var(--sf-line)] pb-2 font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--sf-ink-3)]">Contents / 目录</p>
            <TableOfContents client:idle headings={headings} />
          </aside>
        )}
      </div>
    </article>
    </>
  ) : (
    <section class="mx-auto w-full max-w-3xl px-[var(--sf-pad)] py-20">
      <div class="border-y border-[var(--sf-line)] py-16 text-center">
        <p class="mb-4 flex items-center justify-center gap-3 font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--sf-ink-3)]">
          <span class="h-px w-8 bg-[var(--sf-line-strong)]" aria-hidden="true"></span>
          Not Found / 404
        </p>
        <h2 class="mb-2 text-2xl font-bold tracking-tight text-[var(--sf-ink)]">文章不存在</h2>
        <p class="mb-8 text-sm text-[var(--sf-ink-2)]">该文章可能已被删除，或链接中的 slug 有误。</p>
        <a href="/posts" class="inline-flex min-h-11 items-center gap-2 border border-[var(--sf-line-control)] px-4 text-sm text-[var(--sf-ink)] no-underline transition-colors duration-200 hover:border-[var(--sf-accent)] hover:text-[var(--sf-accent-ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sf-accent)]">
          <span aria-hidden="true">←</span>
          返回文章列表
        </a>
      </div>
    </section>
  )}
</BaseLayout>

<style is:global>
  /* 正文滚动揭示：默认完全可见，禁用 JS 时正文照常可读。
     只有脚本给容器加上 .is-reveal-ready 之后，才进入「隐藏 → 揭示」流程； */
  .reveal-content.is-reveal-ready > div > * {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.45s ease, transform 0.45s ease;
  }
  .reveal-content.is-reveal-ready > div > *.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* 正文色统一跟随设计令牌（global.css 的 .prose 排版保持不变）。
     页面把正文宽度交给阅读列：全局 .prose 的 68ch + 居中会让标题比正文
     左移一大截，这里改为填满阅读列，标题/导语/正文左缘对齐。 */
  .reveal-content.prose {
    color: var(--sf-ink-2);
    max-width: 100%;
    margin-inline: 0;
  }
  .reveal-content.prose p {
    /* 避免中文段落最后一行只剩一两个字的孤行 */
    text-wrap: pretty;
  }
  .reveal-content.prose p,
  .reveal-content.prose li {
    color: var(--sf-ink-2);
  }
  .reveal-content.prose h2,
  .reveal-content.prose h3,
  .reveal-content.prose h4 {
    color: var(--sf-ink);
  }
  .reveal-content.prose a {
    color: var(--sf-accent-ink);
  }

  /* 目录锚点跳转时给固定页头留出空间，标题不会被压在导航下面 */
  .reveal-content :is(h2, h3, h4) {
    scroll-margin-top: calc(var(--header-offset, 4rem) + 1.5rem);
  }

  /* h2 左侧细线在揭示时自上而下展开：单一强调色细线，无渐变 */
  .reveal-content h2 {
    position: relative;
    padding-left: 0.875rem;
  }
  .reveal-content h2::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.18em;
    bottom: 0.18em;
    width: 2px;
    background: var(--sf-accent);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal-content h2.revealed::before {
    transform: scaleY(1);
  }

  .reveal-content pre {
    position: relative;
  }
  .code-copy-btn {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--sf-line);
    border-radius: 3px;
    background: var(--sf-surface);
    color: var(--sf-ink-2);
    cursor: pointer;
    opacity: 0;
    transform: translateY(-2px);
    transition: opacity 0.2s ease, transform 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .code-copy-btn svg {
    width: 0.95rem;
    height: 0.95rem;
  }
  .reveal-content pre:hover .code-copy-btn,
  .code-copy-btn:focus-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .code-copy-btn:hover {
    color: var(--sf-ink);
    border-color: var(--sf-line-control);
  }
  .code-copy-btn.copied {
    color: var(--sf-accent-ink);
    border-color: var(--sf-accent);
    opacity: 1;
    transform: translateY(0);
  }
  @media (hover: none) {
    .code-copy-btn {
      opacity: 0.85;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal-content.is-reveal-ready > div > * {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .reveal-content h2::before {
      transition: none;
      transform: scaleY(1);
    }
    .code-copy-btn {
      transition: none;
    }
  }
</style>

<script>
  // 先确认脚本可用，再给容器加 .is-reveal-ready；无 JS 时正文保持默认可见。
  const revealRoot = document.querySelector<HTMLElement>('.reveal-content');
  const prose = revealRoot?.querySelector<HTMLElement>(':scope > div');

  if (revealRoot && prose) {
    const children = Array.from(prose.children) as HTMLElement[];
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduceMotion) {
      children.forEach((child) => child.classList.add('revealed'));
    } else {
      try {
        // threshold 用 0：超长代码块/列表的高度可能远超视口，用比例阈值会永不触发。
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              const el = entry.target as HTMLElement;
              const idx = children.indexOf(el);
              el.style.transitionDelay = `${Math.min(idx * 40, 400)}ms`;
              el.classList.add('revealed');
              observer.unobserve(el);
            }
          }
        }, { rootMargin: '0px 0px -40px 0px', threshold: 0 });
        // observer 构建成功后才解锁隐藏样式：构造失败时正文保持默认可见，
        // 不会出现「已 opacity:0 且永不揭示」的死路。
        revealRoot.classList.add('is-reveal-ready');
        children.forEach((child) => observer.observe(child));
      } catch {
        // 极端环境（老浏览器/扩展破坏 IO）下退回「全部直接显示」，不让正文消失。
        children.forEach((child) => child.classList.add('revealed'));
      }
    }
  }

  // 代码块悬浮复制按钮（正文是构建期注入的 HTML，用客户端脚本挂载）
  function initCodeCopy() {
    document.querySelectorAll<HTMLElement>('.reveal-content pre').forEach((pre) => {
      if (pre.querySelector('.code-copy-btn')) return;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'code-copy-btn';
      btn.setAttribute('aria-label', '复制代码');
      const copyIcon =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
      const checkIcon =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';
      btn.innerHTML = copyIcon;
      btn.addEventListener('click', async () => {
        const code = pre.querySelector('code')?.innerText ?? pre.innerText;
        try {
          await navigator.clipboard.writeText(code);
          btn.classList.add('copied');
          btn.innerHTML = checkIcon;
          window.setTimeout(() => {
            btn.classList.remove('copied');
            btn.innerHTML = copyIcon;
          }, 1400);
        } catch {
          // 剪贴板不可用（非安全上下文等）时静默失败
        }
      });
      pre.appendChild(btn);
    });
  }
  initCodeCopy();
  document.addEventListener('astro:page-load', initCodeCopy);
</script>

<script>
  import '../../scripts/post-motion';
</script>
