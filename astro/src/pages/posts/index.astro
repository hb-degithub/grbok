---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/posts/PostList';
---

<BaseLayout title="文章列表" description="浏览所有已发布的文章">
  <section class="mx-auto w-full max-w-4xl px-5 py-16 sm:px-8 lg:px-10">
    <header class="mb-10 border-b border-[var(--sf-line)] pb-6">
      <p class="mb-3 flex items-center gap-3 font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--sf-ink-3)]">
        <span class="h-px w-8 bg-[var(--sf-line-strong)]" aria-hidden="true"></span>
        Index / 01
      </p>
      <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
        <h1 class="text-4xl font-bold tracking-tight text-[var(--sf-ink)] sm:text-5xl">所有文章</h1>
        <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--sf-ink-3)]">按发布时间倒序</p>
      </div>
      <p class="mt-3 max-w-xl text-[var(--sf-ink-2)]">
        浏览所有已发布的技术文章和思考。
      </p>
    </header>

    <PostList client:visible perPage={12} />
  </section>
</BaseLayout>
