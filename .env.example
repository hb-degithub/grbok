# ===========================
# 个人博客生产环境配置
# ===========================

# 域名配置
DOMAIN=blog.example.com

# 站点 URL（用于邮件链接、验证回调等）
PUBLIC_SITE_URL=https://blog.example.com

# PocketBase 管理员 IP 白名单（逗号分隔多个 IP）
ADMIN_IP=127.0.0.1
# Exact source CIDR or IP of the production OpenResty peer; never use 0.0.0.0/0.
OPENRESTY_TRUSTED_PROXY=REPLACE_WITH_EXACT_OPENRESTY_SOURCE_CIDR


# Caddy ACME 证书邮箱
CADDY_ACME_EMAIL=admin@example.com

# 全局 Rate Limit（每秒每 IP 请求数）
RATE_LIMIT_PER_IP=10

# 登录站点 Rate Limit（每分钟每 IP 请求数，配合服务端 5 次失败封禁）
LOGIN_RATE_LIMIT_PER_MINUTE=5

# 备份保留天数
BACKUP_RETENTION_DAYS=30

# 时区
TZ=Asia/Shanghai

# PocketBase 加密密钥：生产密钥必须独立随机生成（openssl rand -hex 32），严禁复用本地/示例密钥
# 泄露该密钥可解密 TOTP 密钥/SMTP 密码/ESA 凭证
PB_ENCRYPTION_KEY=CHANGE_ME_RANDOM_64_HEX

# Mail gateway (generic SMTP variables are preferred)
SMTP_HOST=smtp.example.net
SMTP_PORT=587
SMTP_USERNAME=smtp_user@example.net
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_FROM_NAME=Personal Blog
SMTP_TLS_MODE=starttls
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000
MAIL_PROVIDER_LABEL=Standard SMTP
MAIL_ALERT_RECIPIENTS=ops@example.com

# Legacy Aliyun aliases (optional; generic SMTP variables above take precedence)
ALIYUN_SMTP_HOST=
ALIYUN_SMTP_PORT=
ALIYUN_SMTP_USER=
ALIYUN_SMTP_PASSWORD=
ALIYUN_FROM_EMAIL=
ALIYUN_FROM_NAME=

# Mail gateway flags and secrets
MAIL_GATEWAY_INTERNAL_URL=http://admin-auth:8787
MAIL_GATEWAY_ENABLED=false
MAIL_ACCOUNT_ENABLED=false
MAIL_OTP_ENABLED=false
MAIL_INTERNAL_SECRET=REPLACE_WITH_RANDOM_MAIL_INTERNAL_SECRET_AT_LEAST_32_CHARS
MAIL_HASH_SECRET=REPLACE_WITH_RANDOM_MAIL_HASH_SECRET_AT_LEAST_32_CHARS

# Mail security state (PocketBase only; disabled until staged rollout checks pass)
MAIL_ARCHIVE_HMAC_SECRET=REPLACE_WITH_RANDOM_MAIL_ARCHIVE_HMAC_SECRET_AT_LEAST_32_CHARS
MAIL_ARCHIVE_API_ENABLED=false
ACCOUNT_RETENTION_REMINDER_ENABLED=false
ACCOUNT_RETENTION_DELETE_ENABLED=false

# Host-only /etc/hlydwz/mail-archive.env examples; never inject into containers
# Supply one recipient normally; use two comma-separated public recipients only during key rotation.
MAIL_ARCHIVE_AGE_RECIPIENTS=age1replace_with_public_recipient
MAIL_ARCHIVE_AGE_RECIPIENT_FINGERPRINTS=REPLACE_WITH_EXPECTED_PUBLIC_RECIPIENT_FINGERPRINT
MAIL_ARCHIVE_RCLONE_REMOTE=archive-remote
MAIL_ARCHIVE_RCLONE_PREFIX=personal-blog/mail-audit

# 内部 admin-auth 服务配置
ADMIN_AUTH_INTERNAL_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
ADMIN_AUTH_HASH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
ADMIN_AUTH_RP_ID=blog.example.com
ADMIN_AUTH_ORIGIN=https://blog.example.com
ADMIN_AUTH_SESSION_TTL_SECONDS=900
